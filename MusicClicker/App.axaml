<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />

        <!-- Global TextBlock style: white text with a subtle centered shadow outline (fading) -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <!-- Centered drop shadow (zero offset) creates a faded outline around text -->
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="7" Opacity="1.0" OffsetX="0" OffsetY="0" />
            </Setter>
            <!-- Use the bundled Roboto Condensed font for a compact, modern look -->
            <Setter Property="FontFamily" Value="avares://MusicClicker/Fonts/Playfair_Display,Roboto_Condensed/Roboto_Condensed/static/RobotoCondensed-Regular.ttf#Roboto Condensed" />
        </Style>

        <!-- Apply the bundled Roboto Condensed to text-bearing controls only.
             Avoid targeting generic control types to prevent Avalonia style resolution errors. -->
        <Style Selector="TextBox, Window">
            <Setter Property="FontFamily" Value="avares://MusicClicker/Fonts/Playfair_Display,Roboto_Condensed/Roboto_Condensed/static/RobotoCondensed-Regular.ttf#Roboto Condensed" />
        </Style>

        <!-- Global Button style: add drop shadow effect to all buttons -->
        <Style Selector="Button">
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.7" OffsetX="0" OffsetY="0" />
            </Setter>
        </Style>

    </Application.Styles>
</Application>