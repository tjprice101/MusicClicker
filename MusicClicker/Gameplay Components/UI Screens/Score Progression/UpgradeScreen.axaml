<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.UpgradeScreen">

    <Grid>
        <Grid.Background>
            <ImageBrush Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/UpgradeScreenBackground.png" Stretch="UniformToFill" />
        </Grid.Background>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,15,20,10" Spacing="8">
            <TextBlock Text="Upgrades" FontSize="32" FontWeight="Bold" Foreground="White"
                HorizontalAlignment="Center" />
            <TextBlock x:Name="UpgradeNotesTextHeader" Text="Notes: 0" FontSize="22"
                Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Margin="40,160,40,80">

            <StackPanel Spacing="30" HorizontalAlignment="Center">
                <!-- Row 1 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <!-- Chord -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsChord-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Chord" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="ChordOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="ChordCostTextUpgrade" Text="Cost: 10" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +5 Notes Per Second" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyChordButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyChordMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scale -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsScale-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Scale" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="ScaleOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="ScaleCostTextUpgrade" Text="Cost: 50" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +25 Notes Per Second" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyScaleButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyScaleMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Orchestra -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsOrchestra-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Orchestra" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="OrchestraOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="OrchestraCostTextUpgrade" Text="Cost: 100" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +125 Notes Per Second" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyOrchestraButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyOrchestraMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Symphony -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsSymphony-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Symphony" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="SymphonyOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="SymphonyCostTextUpgrade" Text="Cost: 350" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +625 Notes Per Second" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuySymphonyButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuySymphonyMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <!-- Aria -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsAria-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Aria" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="AriaOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="AriaCostTextUpgrade" Text="Cost: 350" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +1 Note on Click" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyAriaButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyAriaMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Requiem -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsRequiem-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Requiem" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="RequiemOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="RequiemCostTextUpgrade" Text="Cost: 750" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +5 Notes on Click" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyRequiemButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyRequiemMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Opus -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsOpus-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Opus" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="OpusOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="OpusCostTextUpgrade" Text="Cost: 1500" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +25 Notes on Click" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyOpusButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyOpusMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Magnum Opus -->
                    <Border Background="#111" BorderBrush="White" BorderThickness="2" Padding="8" Width="320" Height="160">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Upgrade Resources/MusicGameAssetsMagnumOpus-min.png" Width="80" Height="80" Stretch="UniformToFill" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Magnum Opus" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="MagnumOpusOwnedTextUpgrade" Text="Number Owned: 0" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="MagnumOpusCostTextUpgrade" Text="Cost: 3000" FontSize="14" Foreground="White" />
                                <TextBlock Text="Adds +125 Notes on Click" FontSize="13" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button x:Name="BuyMagnumOpusButton" Content="Buy 1" Width="90" Height="30" Background="#222" Foreground="White" />
                                    <Button x:Name="BuyMagnumOpusMaxButton" Content="Buy Max" Width="100" Height="30" Background="#222" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </ScrollViewer>

        <Button x:Name="BackButtonBottom" Content="Back" Width="200" Height="50"
            Background="White" Foreground="Black" FontSize="20"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
    </Grid>
</UserControl>