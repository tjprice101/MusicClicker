                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/LaCampanellaMajorSheets.png"
                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Small Images with Text aligned horizontally -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25"
                            Margin="20,0,0,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/LaCampanellaMajorKey.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="LaCampanellaMajorKeysOwnedText"
                                    Text="0 La Campanella Major Keys Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/LaCampanellaMajorScale.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="LaCampanellaMajorScalesOwnedText"
                                    Text="0 La Campanella Major Scales Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/LaCampanellaMajorProgression.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="LaCampanellaMajorProgressionsOwnedText"
                                    Text="0 La Campanella Major Progressions Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
