                                TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" OffsetX="1" OffsetY="1" BlurRadius="3" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button x:Name="EnigmaHarmonyButton" Width="216" Height="216"
