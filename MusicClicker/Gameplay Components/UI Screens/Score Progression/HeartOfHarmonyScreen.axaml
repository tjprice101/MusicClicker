                            <DropShadowEffect Color="Black" OffsetX="0" OffsetY="4" BlurRadius="12" />
                        </Border.Effect>
                    <Grid Height="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12">
                            <TextBlock x:Name="EroicaMajorSheetsOwnedText"
                                Text="0 Eroica Major Sheets Owned" FontSize="16" Foreground="White"
                                HorizontalAlignment="Center" FontWeight="SemiBold"
                                TextAlignment="Center" />
                            <TextBlock Text="Needs 1 Eroica Major Sheets" FontSize="20"
                                Foreground="#FFFF69B4" HorizontalAlignment="Center" FontWeight="Bold"
                                TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" OffsetX="1" OffsetY="1" BlurRadius="3" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button x:Name="EroicaHarmonyButton" Width="216" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [7518255]-min.png"
                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25"
                            Margin="20,0,0,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [6876507]-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="EroicaMajorKeysOwnedText"
                                    Text="0 Eroica Major Keys Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [CBE124E]-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="EroicaMajorScalesOwnedText"
                                    Text="0 Eroica Major Scales Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [2E061F4]-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="EroicaMajorProgressionsOwnedText"
                                    Text="0 Eroica Major Progressions Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <!-- Swan Lake Major -->
                    <Border Background="#66000000" CornerRadius="8" 
