                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="FateMajorScalesOwnedText"
                                    Text="0 Fate Major Scales Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/FateMajorProgression.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="FateMajorProgressionsOwnedText"
                                    Text="0 Fate Major Progressions Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <!-- Ode to Joy Major -->
                    <Border Background="#66000000" CornerRadius="8" 
                        BorderBrush="#FFFF69B4" BorderThickness="3" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" OffsetX="0" OffsetY="4" BlurRadius="12" />
                        </Border.Effect>
                    <Grid Height="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Texts + Large Button -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12">
                            <TextBlock x:Name="OdeToJoyMajorSheetsOwnedText"
                                Text="0 Ode to Joy Major Sheets Owned" FontSize="16"
                                Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"
                                TextAlignment="Center" />
                            <TextBlock Text="Needs 1 Ode to Joy Major Sheets" FontSize="20"
                                Foreground="#FFFF69B4" HorizontalAlignment="Center" FontWeight="Bold"
                                TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" OffsetX="1" OffsetY="1" BlurRadius="3" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button x:Name="OdeToJoyHarmonyButton" Width="216" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/OdeToJoyMajorSheets.png"
                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Small Images with Text aligned horizontally -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25"
                            Margin="20,0,0,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/OdeToJoyMajorKey.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="OdeToJoyMajorKeysOwnedText"
                                    Text="0 Ode to Joy Major Keys Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/OdeToJoyMajorScale.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="OdeToJoyMajorScalesOwnedText"
                                    Text="0 Ode to Joy Major Scales Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/OdeToJoyMajorProgression.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="OdeToJoyMajorProgressionsOwnedText"
                                    Text="0 Ode to Joy Major Progressions Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Back Button -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,25"
                CornerRadius="8" Background="#66000000" BorderBrush="#FFFF69B4" BorderThickness="3">
                <Border.Effect>
                    <DropShadowEffect Color="Black" OffsetX="0" OffsetY="3" BlurRadius="10" />
                </Border.Effect>
                <Button x:Name="BackButtonHeartOfHarmony" Content="Back" Width="220" Height="55"
                    Background="Transparent" Foreground="White" FontSize="22" FontWeight="Bold"
                    BorderThickness="0" CornerRadius="8">
                </Button>
            </Border>
    </Grid>
</UserControl>
