<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.HeartOfHarmonyScreen">

    <UserControl.Styles>
        <!-- Button hover animation style -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        <Style Selector="Button:not(:pointerover)">
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#AA000000">
        <Grid.Background>
            <ImageBrush
                Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/sacredtrevor_A_ray_of_light_shining_down_onto_a_pink_and_red_wi_d8fbd6c8-2ca7-4ae7-91b0-4c2dd7c79ff4-min.png"
                Stretch="UniformToFill" />
        </Grid.Background>

        <!-- Top Title and Notes -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
            Spacing="8">
            <TextBlock Text="Heart of Harmony" FontSize="42" FontWeight="Bold"
                Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" Opacity="1.0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" OffsetX="2" OffsetY="2" BlurRadius="8" />
                </TextBlock.Effect>
                <TextBlock.Styles>
                    <Style Selector="TextBlock">
                        <Style.Animations>
                            <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </TextBlock.Styles>
            </TextBlock>
            <TextBlock x:Name="HeartOfHarmonyNotesText" Text="Notes: 0" FontSize="24"
                Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold" TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" OffsetX="1" OffsetY="1" BlurRadius="4" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
        <!-- Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled" Margin="40,130,40,90"
            Background="Transparent">
            <StackPanel Orientation="Vertical" Spacing="25">

                    <!-- Moonlight Sonata Major -->
                    <Border Background="#66000000" CornerRadius="8" 
                        BorderBrush="#FFFF69B4" BorderThickness="3" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" OffsetX="0" OffsetY="4" BlurRadius="12" />
                        </Border.Effect>
                    <Grid Height="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Texts + Large Button -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12">
                            <TextBlock x:Name="MoonlightMajorSheetsOwnedText"
                                Text="0 Moonlight Sonata Major Sheets Owned" FontSize="16"
                                Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"
                                TextAlignment="Center" />
                            <TextBlock Text="Needs 1 Moonlight Sonata Major Sheets" FontSize="20"
                                Foreground="#FFFF69B4" HorizontalAlignment="Center" FontWeight="Bold"
                                TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" OffsetX="1" OffsetY="1" BlurRadius="3" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button x:Name="MoonlightHarmonyButton" Width="216" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [9B2D761]-min.png"
                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Small Images with Text aligned horizontally -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25"
                            Margin="20,0,0,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/MoonlightMajorKey-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="MoonlightMajorKeysOwnedText"
                                    Text="0 Moonlight Sonata Major Keys Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/MoonlightMajorScale-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="MoonlightMajorScalesOwnedText"
                                    Text="0 Moonlight Sonata Major Scales Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/MoonlightMajorProgression-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="MoonlightMajorProgressionsOwnedText"
                                    Text="0 Moonlight Sonata Major Progressions Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <!-- Eroica Major -->
