                            <TextBlock x:Name="SwanLakeMajorSheetsOwnedText"
                                Text="0 Swan Lake Major Sheets Owned" FontSize="16"
                                Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"
                                TextAlignment="Center" />
                            <TextBlock Text="Needs 1 Swan Lake Major Sheets" FontSize="20"
