                                <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/EnigmaMajorSheets.png"
                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Small Images with Text aligned horizontally -->
