                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25"
                            Margin="20,0,0,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [C94C657]-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="SwanLakeMajorKeysOwnedText"
                                    Text="0 Swan Lake Major Keys Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [EDD5DE8]-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="SwanLakeMajorScalesOwnedText"
                                    Text="0 Swan Lake Major Scales Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image
                                    Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [B52771B]-min.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="SwanLakeMajorProgressionsOwnedText"
                                    Text="0 Swan Lake Major Progressions Owned" FontSize="15"
                                    Foreground="White"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <!-- La Campanella Major -->
                    <Border Background="#66000000" CornerRadius="8" 
                        BorderBrush="#FFFF69B4" BorderThickness="3" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" OffsetX="0" OffsetY="4" BlurRadius="12" />
                        </Border.Effect>
                    <Grid Height="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Texts + Large Button -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12">
                            <TextBlock x:Name="LaCampanellaMajorSheetsOwnedText"
                                Text="0 La Campanella Major Sheets Owned" FontSize="16"
                                Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"
                                TextAlignment="Center" />
                            <TextBlock Text="Needs 1 La Campanella Major Sheets" FontSize="20"
                                Foreground="#FFFF69B4" HorizontalAlignment="Center" FontWeight="Bold"
                                TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" OffsetX="1" OffsetY="1" BlurRadius="3" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button x:Name="LaCampanellaHarmonyButton" Width="216" Height="216"
