                                    Stretch="UniformToFill" Width="216" Height="216" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Small Images with Text aligned horizontally -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25"
                            Margin="20,0,0,0">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Spacing="8">
                                <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Score Components/FateMajorKey.png"
                                    Width="60" Height="60" Stretch="Uniform" />
                                <TextBlock x:Name="FateMajorKeysOwnedText"
                                    Text="0 Fate Major Keys Owned" FontSize="15"
                                    Foreground="White"
