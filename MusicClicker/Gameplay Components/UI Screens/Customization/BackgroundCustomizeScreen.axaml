<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.BackgroundCustomizeScreen"
             Background="#33000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Scrollable Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,20">
            <TextBlock Text="Background Gallery"
                       FontSize="42"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontWeight="Bold" />
            <TextBlock Text="Select Your Background Theme"
                       FontSize="24"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Scrollable Content - 2x5 Grid (16:9 rectangles) -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="50,0,50,20">

                <StackPanel Spacing="30" HorizontalAlignment="Center">
                <!-- Row 1 - Default & Custom BG 1 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button x:Name="BackgroundOption1" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/sacredtrevor_A_grand_musical_city_lights_everywhere_popular_shi_d84ff662-c87b-4630-9887-25228f42097b-min.png" Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="BackgroundOption2" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/CustomBG1.png" Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Row 2 - Custom BG 2 & Moonlight -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button x:Name="BackgroundOption3" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/CustomBG2.png" Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="BackgroundOption4" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/MoonlightCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Row 3 - Eroica & Swan Lake -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button x:Name="BackgroundOption5" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/EroicaCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="BackgroundOption6" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/SwanLakeCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Row 4 - La Campanella & Enigma -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button x:Name="BackgroundOption7" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/LaCampanellaCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="BackgroundOption8" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/EnigmaCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Row 5 - Fate & Ode to Joy -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button x:Name="BackgroundOption9" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/FateCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="BackgroundOption10" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/OdeToJoyCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Row 6 - Dies Irae & Winter -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    <Button x:Name="BackgroundOption11" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/DiesIraeCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="BackgroundOption12" Width="640" Height="360" Background="Black" BorderBrush="White" BorderThickness="2">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Customization Backgrounds/WinterCUSTOMBG.jpg" Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                </StackPanel>
            
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.7" OffsetX="0" OffsetY="0" />
            </Border.Effect>
            <Button x:Name="BackButton"
                    Content="Back to Gallery"
                    Width="250"
                    Height="50"
                    Background="#55000000"
                    Foreground="White"
                    FontSize="20" />
        </Border>
    </Grid>
</UserControl>