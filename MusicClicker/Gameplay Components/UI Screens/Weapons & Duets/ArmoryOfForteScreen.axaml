                </StackPanel>

            </StackPanel>

            </ScrollViewer>

            <!-- Footer -->
            <Button Grid.Row="2"
                    x:Name="BackButton"
                    Content="Back to Main"
                    Width="250"
                    Height="50"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Background="#55000000"
                    Foreground="White"
                    FontSize="20" />
        </Grid>
    </Panel>
</UserControl>
