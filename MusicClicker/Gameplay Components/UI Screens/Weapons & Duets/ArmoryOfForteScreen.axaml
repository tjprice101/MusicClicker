                    <!-- Item 18 -->
                    <StackPanel Spacing="10" Width="350">
                        <Button x:Name="ArmoryItem18Button" 
                                Width="350" 
                                Height="197"
                                Background="#44000000"
                                BorderBrush="White"
                                BorderThickness="2">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Weapons/TheSnow'sDesire.png" Stretch="UniformToFill" />
                        </Button>
                        <TextBlock x:Name="ArmoryItem18CostText"
                                   Text="Cost: 5,000,000,000 Notes"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem18OwnedText"
                                   Text="Owned: 0"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem18SoloConcertoText"
                                   Text="Solo Concerto: &lt;placeholder&gt;"
