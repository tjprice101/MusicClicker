<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.ArmoryOfForteScreen">

    <Panel>
        <!-- Background image -->
        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/ArmoryHall.png"
               Stretch="UniformToFill"
               ZIndex="0"
               Opacity="1"
               />

        <!-- Main content on top -->
        <Grid ZIndex="1"
              Background="#33000000"> <!-- optional dark overlay -->

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,20,0,20">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Text="Armory of Forte"
                               FontSize="42"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="ArmoryNotesText"
                               Text="Notes: 0"
                               FontSize="24"
                               Foreground="White"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                
                <!-- Entropic Armory Button (Top Right) -->
                <Button x:Name="EntropicArmoryButton"
                        Content="Entropic Armory"
                        Width="200"
                        Height="50"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,50,0"
                        Background="#55000000"
                        Foreground="White"
                        FontSize="18"
                        BorderBrush="White"
                        BorderThickness="2" />
            </Grid>

            <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="50,0,50,20">
            
            <StackPanel Spacing="40" HorizontalAlignment="Center">
                
                <!-- Row 1: Moonlight Sonata Weapons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    
                    <!-- Item 1 -->
                    <StackPanel Spacing="10" Width="350">
                        <Button x:Name="ArmoryItem1Button" 
                                Width="350" 
                                Height="197"
                                Background="#44000000"
                                BorderBrush="White"
                                BorderThickness="2">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Weapons/IncisorOfMoonlight.png"
                                Stretch="UniformToFill" />
                        </Button>
                        <TextBlock x:Name="ArmoryItem1CostText"
                                   Text="Cost: 10,000 Notes"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem1OwnedText"
                                   Text="Owned: 0"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem1SoloConcertoText"
                                   Text="Solo Concerto: Boosts click damage by 10%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem1SymphonicModulationText"
                                   Text="Symphonic Modulation: Increases NPS by 5%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem1DuetText"
                                   Text="Duet Resonance: Increases critical hit chance by 15%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Item 2 -->
                    <StackPanel Spacing="10" Width="350">
                        <Button x:Name="ArmoryItem2Button" 
                                Width="350" 
                                Height="197"
                                Background="#44000000"
                                BorderBrush="White"
                                BorderThickness="2">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Weapons/EulogyOfTheMoon.png"
                                Stretch="UniformToFill" />
                        </Button>
                        <TextBlock x:Name="ArmoryItem2CostText"
                                   Text="Cost: 25,000 Notes"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem2OwnedText"
                                   Text="Owned: 0"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem2SoloConcertoText"
                                   Text="Solo Concerto: Increases note generation by 15%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem2SymphonicModulationText"
                                   Text="Symphonic Modulation: &lt;placeholder&gt;"
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem2DuetText"
                                   Text="Duet Resonance: Amplifies note generation by 20%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Item 3 -->
                    <StackPanel Spacing="10" Width="350">
                        <Button x:Name="ArmoryItem3Button" 
                                Width="350" 
                                Height="197"
                                Background="#44000000"
                                BorderBrush="White"
                                BorderThickness="2">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Weapons/Sakura'sBlossom.png"
                                Stretch="UniformToFill" />
