                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem3OwnedText"
                                   Text="Owned: 0"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem3SoloConcertoText"
                                   Text="Solo Concerto: Reduces ability cooldowns by 5%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem3SymphonicModulationText"
                                   Text="Symphonic Modulation: &lt;placeholder&gt;"
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmoryItem3DuetText"
                                   Text="Duet Resonance: Reduces cooldowns by 10%."
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                </StackPanel>

                <!-- Row 2: Eroica & Swan Lake -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    
