<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.UniteTheSymphonyScreen">

    <Grid Background="#AA000000">
        <Grid.Background>
            <ImageBrush Source="avares://MusicClicker/Assets/Concert Hall Menu-min.png"
                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,15,20,10"
            Spacing="8">
                <TextBlock Text="Unite the Symphony" FontSize="32" FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="UnityNotesTextHeader" Text="Notes: 0" FontSize="22"
                    Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="EntropicMelodyText" Text="Entropic Melody: 0" FontSize="18"
                    Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="20,100,20,80" Background="Transparent">
                <StackPanel Orientation="Vertical" Spacing="20">

                    <!-- Moonlight Sonata Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" /> <!-- Left owned/effect -->
                                <ColumnDefinition Width="384" /> <!-- Button -->
                                <ColumnDefinition Width="*" /> <!-- Requirements -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="MoonlightMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 3,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="MoonlightMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [1701D72]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Minor Key of Moonlight Sonata" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Scale of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="1 Minor Progression of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="10 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Moonlight Sonata Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="MoonlightMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Tempo Resonate Ability: Adds your current Notes per Second to your Notes per Click." Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="MoonlightMajorDissolveButton" Content="Dissolve" Width="120" Height="26" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="MoonlightMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [978EB92]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Major Key of Moonlight Sonata" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Scale of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="1 Major Progression of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="10 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Eroica Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="EroicaMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 8,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="EroicaMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [1F82811]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Minor Key of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Scale of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Progression of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="15 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Eroica Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="EroicaMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Tempo Resonate Ability: Uniting a Major Score gives 2 of the corresponding Minor Score." Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="EroicaMajorDissolveButton" Content="Dissolve" Width="120" Height="26" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="EroicaMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [04AC7F2]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Major Key of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Scale of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Progression of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="15 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Swan Lake Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="SwanMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 15,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="SwanMinorButton" Grid.Column="1" Margin="5" Width="384"
                                Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [B5BBBBC]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Minor Key of Swan Lake" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Scale of Swan Lake" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Progression of Swan Lake"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="20 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Swan Lake Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="SwanMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Crescendance Ability" Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="SwanMajorDissolveButton" Content="Dissolve" Width="120" Height="26" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="SwanMajorButton" Grid.Column="1" Margin="5" Width="384"
                                Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [876DEE6]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Major Key of Swan Lake" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Scale of Swan Lake" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Progression of Swan Lake"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="20 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- La Campanella Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="LaCampanellaMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 35,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="LaCampanellaMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image Source="avares://MusicClicker/Assets/LaCampanellaMinor.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Minor Key of La Campanella" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Scale of La Campanella" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Progression of La Campanella"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="25 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- La Campanella Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="LaCampanellaMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Tempo Resonate Ability: Notes Per Second updates every .5 seconds." Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="LaCampanellaMajorDissolveButton" Content="Dissolve" Width="120" Height="26" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="LaCampanellaMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image Source="avares://MusicClicker/Assets/LaCampanellaMajor.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Major Key of La Campanella" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Scale of La Campanella" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Progression of La Campanella"
                                    Foreground="White" FontSize="14" />
                                <TextBlock Text="25 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Enigma Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="EnigmaMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 75,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="EnigmaMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/EnigmaVariationsMinor.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Minor Key of Enigma" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Scale of Enigma" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Minor Progression of Enigma" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="30 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Enigma Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="EnigmaMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Tempo Resonate Ability: ???" Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="EnigmaMajorDissolveButton" Content="Dissolve" Width="120" Height="26" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="EnigmaMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image Source="avares://MusicClicker/Assets/EnigmaMajor.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="1 Major Key of Enigma" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Scale of Enigma" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="1 Major Progression of Enigma" Foreground="White"
                                    FontSize="14" />
                                <TextBlock Text="30 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fate Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="FateMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 135,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="FateMinorButton" Grid.Column="1" Margin="5" Width="384"
