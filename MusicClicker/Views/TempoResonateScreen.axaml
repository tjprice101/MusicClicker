<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.TempoResonateScreen">

    <Grid Background="#AA000000">
        <Grid.Background>
            <ImageBrush Source="avares://MusicClicker/Assets/TempoResonateBG.png"
                        Stretch="UniformToFill" />
        </Grid.Background>

        <!-- Title -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock Text="Tempo Resonate" FontSize="36" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Scrollable drawer on the left -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Width="280" Margin="20,100,0,20"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch">
            <StackPanel x:Name="LeftDrawerPanel" Orientation="Vertical" Spacing="10" />
        </ScrollViewer>

        <!-- Equip prompt panel above equip image -->
        <StackPanel x:Name="EquipPromptPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsVisible="False"
                    Spacing="10"
                    Margin="0,150,0,0"> 
            <TextBlock x:Name="EquipPromptText"
                       Text="Equip X?"
                       Foreground="White"
                       FontSize="20" />
            <Button x:Name="EquipYesButton" Content="Yes" Width="80" />
            <Button x:Name="EquipNoButton" Content="No" Width="80" />
        </StackPanel>

        <!-- Centered content wrapper -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    Margin="0,100,0,0">

            <!-- Equipped score display -->
            <Border x:Name="EquippedScoreDisplay"
                    Width="300" Height="170"
                    Background="#555"
                    CornerRadius="8"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="EquippedScoreText"
                           Text="Equipped Score"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Border>

            <!-- Horizontal placeholder rectangles -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="25"
                        Margin="0,60,0,0">
                <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
                <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
                <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
            </StackPanel>
        </StackPanel>

        <!-- Back button -->
        <Button x:Name="BackButtonTempoResonate" Content="Back"
                Width="200" Height="50"
                Background="White" Foreground="Black"
                FontSize="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20" />
    </Grid>
</UserControl>