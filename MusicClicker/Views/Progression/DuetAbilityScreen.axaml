<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.DuetAbilityScreen">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="Duet Resonance Ability"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

            <!-- Ability Description -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Spacing="3"
                        Margin="0,0,0,3">
                
                <TextBlock x:Name="DuetAbilityNameText"
                           Text="Ability Name"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#e94560" BlurRadius="12" Opacity="0.6" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="DuetAbilityDescriptionText"
                           Text="Ability description will appear here"
                           FontSize="11"
                           Foreground="White"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           TextWrapping="Wrap"
                           Margin="0,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" Opacity="1.0" OffsetX="0" OffsetY="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="DuetAbilityStatusText"
                           Text="Ready"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#4ecca3"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           Margin="0,1,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.7" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Victory March Progress Bar (only visible for Eroica Duet) -->
                <Border x:Name="VictoryMarchProgressBorder"
                        Width="340"
                        Height="22"
                        Background="#2a2a40"
                        CornerRadius="12"
                        Margin="0,3,0,0"
                        IsVisible="False">
                    <Grid>
                        <Border x:Name="VictoryMarchProgressFill"
                                HorizontalAlignment="Left"
                                CornerRadius="15"
                                Background="#FFD700"
                                Width="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFA500" BlurRadius="15" Opacity="0.7" />
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="VictoryMarchProgressText"
                                   Text="0 / 100"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Fate Duet: Hourglass Reversal Visual (only visible for Fate Duet) -->
                <Border x:Name="FateHourglassDisplay"
                        Width="340"
                        Height="80"
                        Background="#33200064"
                        CornerRadius="8"
                        Margin="0,3,0,0"
                        IsVisible="False">
                    <Grid>
                        <!-- Hourglass ASCII Art -->
                        <TextBlock x:Name="FateHourglassArt"
                                   FontSize="32"
                                   FontFamily="Consolas"
                                   Foreground="#C864DC"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Text="⌛">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF96FF" BlurRadius="12" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>
                        
                        <!-- Phase and Counter Display -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="FatePhaseText"
                                       Text="BANKING PHASE"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#C864DC"
                                       HorizontalAlignment="Right">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="FateBankedActionsText"
                                       Text="Actions Banked: 0"
                                       FontSize="12"
                                       Foreground="#FF96FF"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Ode to Joy Duet: Musical Staff Visual (only visible for Ode Duet) -->
                <Border x:Name="OdeStaffDisplay"
                        Width="340"
                        Height="100"
                        Background="#33F0F0F0"
                        CornerRadius="8"
                        Margin="0,3,0,0"
                        IsVisible="False">
                    <Grid>
                        <!-- Musical Staff Lines -->
                        <Canvas Width="300" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 5 staff lines -->
                            <Line StartPoint="10,8" EndPoint="290,8" Stroke="#505050" StrokeThickness="1.5" />
                            <Line StartPoint="10,20" EndPoint="290,20" Stroke="#505050" StrokeThickness="1.5" />
                            <Line StartPoint="10,32" EndPoint="290,32" Stroke="#505050" StrokeThickness="1.5" />
                            <Line StartPoint="10,44" EndPoint="290,44" Stroke="#505050" StrokeThickness="1.5" />
                            <Line StartPoint="10,56" EndPoint="290,56" Stroke="#505050" StrokeThickness="1.5" />
                            
                            <!-- Notes will be added dynamically in code -->
                            <StackPanel x:Name="OdeNotesPanel" Orientation="Horizontal" Canvas.Left="15" Canvas.Top="0" />
                        </Canvas>
                        
                        <!-- Progress Text -->
                        <TextBlock x:Name="OdeNotesCountText"
                                   Text="Notes: 0 / 16"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,4">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" BlurRadius="4" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Resonate Button -->
            <Border x:Name="ActivateButtonBorder"
                    Grid.Row="1"
                    Margin="0,2,0,1"
                    CornerRadius="10"
                    Background="#e94560">
                <Border.Effect>
                    <DropShadowEffect Color="#e94560" BlurRadius="20" Opacity="0.5" />
                </Border.Effect>
                
                <Button x:Name="ActivateDuetAbilityButton"
                        Content="RESONATE"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.5" />
                    </Button.Effect>
                </Button>
            </Border>

            <!-- Close Button -->
            <Grid Grid.Row="2" Margin="0,1,0,3">
                <Border CornerRadius="8"
                        Background="#444455">
                    <Button x:Name="CloseDuetAbilityButton"
                            Content="CLOSE"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#cccccc"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </Border>
            </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
</UserControl>