<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.DuetAbilityScreen">

    <Border x:Name="MainBorder"
            Width="500" Height="650"
            Background="#DD1a1a2e"
            CornerRadius="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,20,20">
        
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.9" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border x:Name="TitleBorder"
                    Grid.Row="0"
                    Background="#16213e"
                    CornerRadius="20,20,0,0"
                    Padding="20,15,20,15">
                <TextBlock x:Name="TitleText"
                           Text="Duet Resonance Ability"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#e94560"
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Ability Description -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Margin="20,15,20,15">
                
                <TextBlock x:Name="DuetAbilityNameText"
                           Text="Ability Name"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="350">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#e94560" BlurRadius="12" Opacity="0.6" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="DuetAbilityDescriptionText"
                           Text="Ability description will appear here"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Left"
                           TextWrapping="Wrap"
                           MaxWidth="450"
                           Margin="0,3,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" Opacity="1.0" OffsetX="0" OffsetY="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="DuetAbilityStatusText"
                           Text="Ready"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#4ecca3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,8,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.7" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Victory March Progress Bar (only visible for Eroica Duet) -->
                <Border x:Name="VictoryMarchProgressBorder"
                        Width="340"
                        Height="26"
                        Background="#2a2a40"
                        CornerRadius="15"
                        Margin="0,8,0,0"
                        IsVisible="False">
                    <Grid>
                        <Border x:Name="VictoryMarchProgressFill"
                                HorizontalAlignment="Left"
                                CornerRadius="15"
                                Background="#FFD700"
                                Width="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFA500" BlurRadius="15" Opacity="0.7" />
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="VictoryMarchProgressText"
                                   Text="0 / 100"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Resonate Button -->
            <Border x:Name="ActivateButtonBorder"
                    Grid.Row="2"
                    Margin="20,8,20,5"
                    CornerRadius="15"
                    Background="#e94560">
                <Border.Effect>
                    <DropShadowEffect Color="#e94560" BlurRadius="20" Opacity="0.5" />
                </Border.Effect>
                
                <Button x:Name="ActivateDuetAbilityButton"
                        Content="RESONATE"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Height="60"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.5" />
                    </Button.Effect>
                </Button>
            </Border>

            <!-- Close Button -->
            <Grid Grid.Row="3" Margin="20,5,20,15">
                <Border CornerRadius="12"
                        Background="#444455">
                    <Button x:Name="CloseDuetAbilityButton"
                            Content="CLOSE"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#cccccc"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="45"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>