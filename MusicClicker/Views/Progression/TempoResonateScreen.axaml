<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.TempoResonateScreen">

    <Grid Background="#AA000000">
        <Grid.Background>
            <ImageBrush Source="avares://MusicClicker/Assets/TempoResonateBG.png"
                        Stretch="UniformToFill" />
        </Grid.Background>

        <!-- Title -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock Text="Tempo Resonate" FontSize="36" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Scrollable drawer on the left -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Width="280" Margin="20,100,0,20"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch">
            <StackPanel x:Name="LeftDrawerPanel" Orientation="Vertical" Spacing="10" />
        </ScrollViewer>

        <!-- Equip prompt panel above equip image -->
        <StackPanel x:Name="EquipPromptPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsVisible="False"
                    Spacing="10"
                    Margin="0,150,0,0"> 
            <TextBlock x:Name="EquipPromptText"
                       Text="Equip X?"
                       Foreground="White"
                       FontSize="20" />
            <Button x:Name="EquipYesButton" Content="Yes" Width="80" />
            <Button x:Name="EquipNoButton" Content="No" Width="80" />
        </StackPanel>

        <!-- Centered content wrapper -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    Margin="0,100,0,0">

            <!-- Equipped score display -->
            <Border x:Name="EquippedScoreDisplay"
                    Width="300" Height="170"
                    Background="#555"
                    CornerRadius="8"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="EquippedScoreText"
                           Text="Equipped Score"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Border>

            <!-- Two small weapon slot boxes centered under the equipped score -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20"
                        Margin="0,20,0,0">
                <Border x:Name="EquippedWeaponDisplay1" Width="256" Height="144" Background="#333" CornerRadius="8">
                    <TextBlock x:Name="EquippedWeaponText1" Text="Weapon Slot 1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Border>
                <Border x:Name="EquippedWeaponDisplay2" Width="256" Height="144" Background="#333" CornerRadius="8">
                    <TextBlock x:Name="EquippedWeaponText2" Text="Weapon Slot 2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>

            <!-- Duet Resonance Display -->
            <TextBlock x:Name="DuetResonanceText"
                       Text=""
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="600"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Scrollable drawer on the right for Weapons (Armory of Forte) -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Width="280" Margin="0,100,20,20"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <StackPanel x:Name="RightDrawerPanel" Orientation="Vertical" Spacing="10" />
        </ScrollViewer>

        <!-- Back button -->
        <Button x:Name="BackButtonTempoResonate" Content="Back"
                Width="200" Height="50"
                Background="White" Foreground="Black"
                FontSize="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20" />
    </Grid>
</UserControl>