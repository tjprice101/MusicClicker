                                <TextBlock x:Name="OdeToJoyMinorScaleText" Text="1 Minor Scale of Ode to Joy" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="OdeToJoyMinorProgressionText" Text="1 Minor Progression of Ode to Joy"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="OdeToJoyMinorMelodiousText" Text="40 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ode to Joy Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="OdeToJoyMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Tempo Resonate Ability: Guarantees 1 major sheet on each click in the Save the Souls menu." Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="OdeToJoyMajorDissolveButton" Content="Dissolve" Width="120" Height="32" HorizontalAlignment="Center" />
                                <TextBlock Text="(+1 Entropic Melody)" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button x:Name="OdeToJoyMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image Source="avares://MusicClicker/Assets/OdeToJoyMajor.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="OdeToJoyMajorKeyText" Text="1 Major Key of Ode to Joy" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="OdeToJoyMajorScaleText" Text="1 Major Scale of Ode to Joy" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="OdeToJoyMajorProgressionText" Text="1 Major Progression of Ode to Joy"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="OdeToJoyMajorHarmoniousText" Text="40 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="BackButtonUnitySymphony" Content="Back" Width="200" Height="50"
                Background="White" Foreground="Black" FontSize="20"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
    </Grid>
</UserControl>