<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.UniteTheSymphonyScreen">

    <Grid Background="#AA000000">
        <Grid.Background>
            <ImageBrush Source="avares://MusicClicker/Assets/Concert Hall Menu-min.png"
                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,15,20,10"
            Spacing="8">
                <TextBlock Text="Unite the Symphony" FontSize="32" FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="UnityNotesTextHeader" Text="Notes: 0" FontSize="22"
                    Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="EntropicMelodyText" Text="Entropic Melody: 0" FontSize="18"
                    Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="20,130,20,80" Background="Transparent">
                <StackPanel Orientation="Vertical" Spacing="20">

                    <!-- Moonlight Sonata Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" /> <!-- Left owned/effect -->
                                <ColumnDefinition Width="384" /> <!-- Button -->
                                <ColumnDefinition Width="*" /> <!-- Requirements -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="MoonlightMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 3,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="MoonlightMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [1701D72]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="MoonlightMinorKeyText" Text="1 Minor Key of Moonlight Sonata" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="MoonlightMinorScaleText" Text="1 Minor Scale of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="MoonlightMinorProgressionText" Text="1 Minor Progression of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="MoonlightMinorMelodiousText" Text="10 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Moonlight Sonata Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="MoonlightMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Crescendance Ability: Adds your current Notes per Second to your Notes per Click. When duet is active and resonating with Moonlight Sonata, all 4 moon phases activate simultaneously!" Foreground="White"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="MoonlightMajorDissolveButton" Content="Dissolve" Width="120" Height="32" HorizontalAlignment="Center" />
                                <TextBlock Text="(+1 Entropic Melody)" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button x:Name="MoonlightMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [978EB92]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="MoonlightMajorKeyText" Text="1 Major Key of Moonlight Sonata" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="MoonlightMajorScaleText" Text="1 Major Scale of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="MoonlightMajorProgressionText" Text="1 Major Progression of Moonlight Sonata"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="MoonlightMajorHarmoniousText" Text="10 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Eroica Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="EroicaMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 8,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="EroicaMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [1F82811]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="EroicaMinorKeyText" Text="1 Minor Key of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="EroicaMinorScaleText" Text="1 Minor Scale of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="EroicaMinorProgressionText" Text="1 Minor Progression of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="EroicaMinorMelodiousText" Text="15 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Eroica Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="EroicaMajorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Crescendance Ability: Triumph of Heroes - Every Major Score crafted doubles your current notes." Foreground="White"
                                    FontSize="14" TextWrapping="Wrap" Width="190"
                                    HorizontalAlignment="Center" />
                                <Button x:Name="EroicaMajorDissolveButton" Content="Dissolve" Width="120" Height="32" HorizontalAlignment="Center" />
                                <TextBlock Text="(+1 Entropic Melody)" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button x:Name="EroicaMajorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [04AC7F2]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="EroicaMajorKeyText" Text="1 Major Key of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="EroicaMajorScaleText" Text="1 Major Scale of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="EroicaMajorProgressionText" Text="1 Major Progression of Eroica" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="EroicaMajorHarmoniousText" Text="15 Harmonious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Swan Lake Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="SwanMinorOwnedText" Text="0 Owned"
                                    Foreground="White"
                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 15,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="SwanMinorButton" Grid.Column="1" Margin="5" Width="384"
