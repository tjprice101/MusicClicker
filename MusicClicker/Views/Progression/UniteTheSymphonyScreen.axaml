                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [B5BBBBC]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
                                Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="SwanMinorKeyText" Text="1 Minor Key of Swan Lake" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="SwanMinorScaleText" Text="1 Minor Scale of Swan Lake" Foreground="White"
                                    FontSize="14" />
                                <TextBlock x:Name="SwanMinorProgressionText" Text="1 Minor Progression of Swan Lake"
                                    Foreground="White" FontSize="14" />
                                <TextBlock x:Name="SwanMinorMelodiousText" Text="20 Melodious Fragments" Foreground="White"
                                    FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Swan Lake Major -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
