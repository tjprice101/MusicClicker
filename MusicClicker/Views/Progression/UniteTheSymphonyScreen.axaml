                                    FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Adds 255,000 NPS" Foreground="White" FontSize="14"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="OdeToJoyMinorButton" Grid.Column="1" Margin="5"
                                Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image Source="avares://MusicClicker/Assets/OdeToJoyMinor.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="15"
