                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ode to Joy Minor -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
