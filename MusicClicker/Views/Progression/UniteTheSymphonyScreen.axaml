                                <Button x:Name="FateMajorDissolveButton" Content="Dissolve" Width="120" Height="32" HorizontalAlignment="Center" />
                                <TextBlock Text="(+1 Entropic Melody)" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button x:Name="FateMajorButton" Grid.Column="1" Margin="5" Width="384"
