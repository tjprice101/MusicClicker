<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.SymphonicGalleryScreen"
             Background="#33000000">

    <Grid>
        <Grid.Background>
            <ImageBrush
                Source="avares://MusicClicker/Assets/CustomizeScreenBackground.png"
                Stretch="UniformToFill" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,20">
            <TextBlock Text="Symphonic Gallery"
                       FontSize="42"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontWeight="Bold" />
            <TextBlock Text="Customize Your Experience"
                       FontSize="24"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Content - Two 9:16 Rectangle Buttons -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="50">
                
                <!-- Clicker Button Customization -->
                <StackPanel Spacing="15">
                    <Border>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.7" OffsetX="0" OffsetY="0" />
                        </Border.Effect>
                        <Button x:Name="ClickerCustomizeButton"
                                Width="270"
                                Height="480"
                                Background="Black"
                                BorderBrush="White"
                                BorderThickness="3">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                                <!--<emoji removed: replaced with empty spacer for aesthetics>-->
                                <TextBlock Text="" FontSize="72" HorizontalAlignment="Center" />
                                <TextBlock Text="Customize"
                                           FontSize="32"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold" />
                                <TextBlock Text="Clicker Button"
                                           FontSize="24"
                                           Foreground="White"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <!-- Background Customization -->
                <StackPanel Spacing="15">
                    <Border>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.7" OffsetX="0" OffsetY="0" />
                        </Border.Effect>
                        <Button x:Name="BackgroundCustomizeButton"
                                Width="270"
                                Height="480"
                                Background="Black"
                                BorderBrush="White"
                                BorderThickness="3">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                                <!--<emoji removed: replaced with empty spacer for aesthetics>-->
                                <TextBlock Text="" FontSize="72" HorizontalAlignment="Center" />
                                <TextBlock Text="Customize"
                                           FontSize="32"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold" />
                            <TextBlock Text="Background"
                                       FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Button Grid.Row="2"
                x:Name="BackButton"
                Content="Back to Main"
                Width="250"
                Height="50"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Background="#55000000"
                Foreground="White"
                FontSize="20" />
    </Grid>
</UserControl>