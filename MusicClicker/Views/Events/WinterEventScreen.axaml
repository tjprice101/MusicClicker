<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.WinterEventScreen">

    <Panel>
        <!-- Background image -->
        <Image Source="avares://MusicClicker/Assets/WinterEventBackground.jpg"
               Stretch="UniformToFill"
               ZIndex="0"
               Opacity="1" />

        <Border ZIndex="1"
            Background="#33000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Grid ZIndex="2"
            Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10" Margin="0,30,0,30">
            <TextBlock Text="Winter Event"
                       FontSize="42"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Opacity="1.0">
                <TextBlock.Styles>
                    <Style Selector="TextBlock">
                        <Style.Animations>
                            <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </TextBlock.Styles>
            </TextBlock>
            <TextBlock x:Name="WinterCountdownText"
                       Text="Time Remaining: --:--:--:--"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Opacity="0.95" />
            <TextBlock x:Name="NotesText"
                       Text="Notes: 0"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="NpsText"
                       Text="Notes Per Second: 0"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Event Content - Horizontal Layout -->
          <Grid Grid.Row="1" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Top"
              Margin="60,0,60,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="475" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="475" />
            </Grid.ColumnDefinitions>
            
            <!-- Soul of Winter Section -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="15">
                <!-- Soul of Winter Button (16:9, 18% smaller than 640x360 = 525x295) -->
                <Button x:Name="SoulOfWinterButton"
                    Width="475"
                    Height="266"
                        Background="Transparent"
                        BorderBrush="#FFFF69B4"
                        BorderThickness="3"
                        HorizontalAlignment="Center">
                    <Image Source="avares://MusicClicker/Assets/SoulOfWinter.png"
                           Stretch="UniformToFill" />
                </Button>
                
                <!-- Cost Text -->
                <TextBlock x:Name="SoulOfWinterCostText"
                           Text="0 Notes for Soul Resonance"
                           FontSize="20"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="1000"
                           Height="30" />
                
                <!-- Owned Text -->
                <TextBlock x:Name="WinterMajorOwnedText"
                           Text="Major Sheets of Winter Owned: 0"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Height="25" />
                           
                <!-- spacer removed; using Top alignment to keep images aligned -->
            </StackPanel>

            <!-- Winter Major Section -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="15">
                <!-- Winter Major Button (16:9, 18% smaller) -->
                <Button x:Name="WinterMajorButton"
                    Width="475"
                    Height="266"
                        Background="Transparent"
                        BorderBrush="#FFFF69B4"
                        BorderThickness="3"
                        HorizontalAlignment="Center">
                    <Image Source="avares://MusicClicker/Assets/WinterMajor.png"
                           Stretch="UniformToFill" />
                </Button>
                
                <!-- Number Owned -->
                <TextBlock x:Name="WinterMajorOwnedRightText"
                           Text="Number Owned: 0"
                           FontSize="20"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="1000"
                           Height="30" />

                <!-- Crescendance Ability placeholder (scrollable) -->
                <ScrollViewer Width="475" MaxHeight="140" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="WinterCrescendanceText"
                               Text="Crescendance Ability: Requiem of the Frozen Choir — Collect Frigid Melodies by freezing the flow of time. Consume them to create Eternal Frost (brief empowered click bursts) or Regal Snowlight (immediate note and fragment bonuses); stacking strengthens these consumptions."
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="475" />
                </ScrollViewer>
                           
                <!-- Timer Displays -->
                <StackPanel Spacing="5" HorizontalAlignment="Center" Height="60">
                    <TextBlock x:Name="NpsFreezeTimerText"
                               Text=""
                               Foreground="#FF00FF00"
                               FontSize="14"
                               IsVisible="False"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF00FF00" BlurRadius="8" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="BlizzardBountyTimerText"
                               Text=""
                               Foreground="#FF00FF00"
                               FontSize="14"
                               IsVisible="False"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF00FF00" BlurRadius="8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- Footer -->
        <Button Grid.Row="2"
                x:Name="BackButton"
                Content="Back to Events"
                Width="250"
                Height="50"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"
                Background="#55000000"
                Foreground="White"
                FontSize="20" />
    </Grid>
    </Panel>
</UserControl>