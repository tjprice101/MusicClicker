<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicClicker.Views.ArmorOfForteScreen"
             Background="#33000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Scrollable Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,20">
            <TextBlock Text="Armor of Forte"
                       FontSize="42"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontWeight="Bold" />
            <TextBlock x:Name="ArmorNotesText"
                       Text="Notes: 0"
                       FontSize="24"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="50,0,50,20">
            
            <StackPanel Spacing="40" HorizontalAlignment="Center">
                
                <!-- Row 1: Moonlight Sonata Weapons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                    
                    <!-- Item 1 -->
                    <StackPanel Spacing="10" Width="350">
                        <Button x:Name="ArmorItem1Button" 
                                Width="350" 
                                Height="197"
                                Background="#44000000"
                                BorderBrush="White"
                                BorderThickness="2">
                            <Image Source="avares://MusicClicker/Assets/MoonlightWeapon1.png"
                                   Stretch="UniformToFill" />
                        </Button>
                        <TextBlock x:Name="ArmorItem1CostText"
                                   Text="Cost: 10,000 Notes"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmorItem1OwnedText"
                                   Text="Owned: 0"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmorItem1SoloConcertoText"
                                   Text="Solo Concerto: &lt;placeholder&gt;"
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmorItem1SymphonicModulationText"
                                   Text="Symphonic Modulation: &lt;placeholder&gt;"
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Item 2 -->
                    <StackPanel Spacing="10" Width="350">
                        <Button x:Name="ArmorItem2Button" 
                                Width="350" 
                                Height="197"
                                Background="#44000000"
                                BorderBrush="White"
                                BorderThickness="2">
                            <Image Source="avares://MusicClicker/Assets/MoonlightWeapon2.png"
                                   Stretch="UniformToFill" />
                        </Button>
                        <TextBlock x:Name="ArmorItem2CostText"
                                   Text="Cost: 25,000 Notes"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmorItem2OwnedText"
                                   Text="Owned: 0"
                                   FontSize="18"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmorItem2SoloConcertoText"
                                   Text="Solo Concerto: &lt;placeholder&gt;"
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ArmorItem2SymphonicModulationText"
                                   Text="Symphonic Modulation: &lt;placeholder&gt;"
                                   FontSize="14"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Item 3 -->
