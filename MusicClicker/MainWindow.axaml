<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:MusicClicker.Views"
    x:Class="MusicClicker.MainWindow"
    Title="🌹🎹 Magnum Opus 🎹🌹"
    Width="1600" Height="900">

    <Window.Background>
        <ImageBrush
            Source="avares://MusicClicker/Assets/sacredtrevor_A_grand_musical_city_lights_everywhere_popular_shi_d84ff662-c87b-4630-9887-25228f42097b-min.png"
            Stretch="UniformToFill" />
    </Window.Background>

    <Grid>
        <!-- Main Screen -->
        <Grid x:Name="MainScreen">
            <!-- Main Grid Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Left navigation buttons -->
                    <ColumnDefinition Width="*" />    <!-- Main clicker content -->
                    <ColumnDefinition Width="Auto" /> <!-- Right side buttons -->
                </Grid.ColumnDefinitions>

                <!-- Right side buttons -->
<StackPanel Grid.Column="2"
            Orientation="Vertical"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,10,30,0"
            Spacing="10">

    <!-- Tempo Resonate Button -->
    <Button x:Name="TempoResonateButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/TempoResonate.png"
               Stretch="UniformToFill" />
    </Button>

    <!-- Eternal Modulation Button -->
    <Button x:Name="EternalModulationButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/EternalModulation.png"
               Stretch="UniformToFill" />
    </Button>

    <!-- Armor of Forte Button -->
    <Button x:Name="ArmorOfForteButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/ArmoryofForte.png"
               Stretch="UniformToFill" />
    </Button>

    <!-- Symphonic Gallery Button -->
    <Button x:Name="SymphonicGalleryButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/SymphonicGallery.png"
               Stretch="UniformToFill" />
    </Button>
</StackPanel>
                <!-- Left side buttons -->
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="30,10,0,0" Spacing="10">
                    <Button x:Name="FragmentationButton" Width="300" Height="170">
                        <Image Source="avares://MusicClicker/Assets/Fragmentation Button-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="ResonanceButton" Width="300" Height="170">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [C690BBF]-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="MelodyButton" Width="300" Height="170">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [2299EA4]-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="HarmonyButton" Width="300" Height="170">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [5A28B4B]-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Content Grid - Kept at left position but everything centered within it -->
                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="50,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Title and Notes -->
                        <RowDefinition Height="Auto" /> <!-- Click Button -->
                        <RowDefinition Height="Auto" /> <!-- Upgrades Button -->
                        <RowDefinition Height="Auto" /> <!-- Essence Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title and Notes -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10"
                        Margin="0,0,0,30">
                        <TextBlock Text="🌹🎹 Magnum Opus 🎹🌹" FontSize="36" Foreground="White"
                            HorizontalAlignment="Center" FontWeight="Bold" />
                        <TextBlock x:Name="NotesText" Text="Notes: 0" FontSize="28"
                            Foreground="White"
                            HorizontalAlignment="Center" />
                        <TextBlock x:Name="NpsText" Text="Notes Per Second: 0" FontSize="22"
                            Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Main Click Button -->
                    <Button Grid.Row="1" x:Name="ClickButton" Width="200" Height="200"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game Assets [A961E2A]-min.png"
                            Stretch="Uniform" />
                    </Button>

                    <!-- Upgrades Button -->
                    <Button Grid.Row="2" x:Name="OpenUpgradesButton" Content="Upgrades"
                        Width="250" Height="50" Background="#55000000" Foreground="White"
                        FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,30" />

                    <!-- Essence Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Spacing="40" Margin="0,10,0,0">

                        <!-- Essence of Beethoven -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Beethoven" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssenceBeethovenButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game Assets [7EA44B0]-min.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="500 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssenceBeethovenOwnedText" Text="0 Owned"
                                FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Essence of Pyotr -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Pyotr" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssencePyotrButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game Assets [8895F90]-min.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="1500 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssencePyotrOwnedText" Text="0 Owned" FontSize="14"
                                Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Essence of Elgar -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Elgar" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssenceElgarButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/EssenceOfElgar.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="4000 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssenceElgarOwnedText" Text="0 Owned"
                                FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Essence of Liszt -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Liszt" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssenceLisztButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/EssenceOfLiszt.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="6000 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssenceLisztOwnedText" Text="0 Owned"
                                FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

<!-- Tempo Resonate Screen -->
<Grid x:Name="TempoResonateScreen" IsVisible="False">
    <Grid.Background>
        <ImageBrush Source="avares://MusicClicker/Assets/TempoResonateBG.png"
                    Stretch="UniformToFill" />
    </Grid.Background>

    <!-- Title -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
        <TextBlock Text="Tempo Resonate" FontSize="36" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Scrollable drawer on the left -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Width="280" Margin="20,100,0,20"
                  HorizontalAlignment="Left" VerticalAlignment="Stretch">
        <StackPanel x:Name="LeftDrawerPanel" Orientation="Vertical" Spacing="10" />
    </ScrollViewer>

    <!-- Equip prompt panel above equip image -->
<StackPanel x:Name="EquipPromptPanel"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsVisible="False"
            Spacing="10"
            Margin="0,150,0,0"> 
    <TextBlock x:Name="EquipPromptText"
               Text="Equip X?"
               Foreground="White"
               FontSize="20" />
    <Button x:Name="EquipYesButton" Content="Yes" Width="80" />
    <Button x:Name="EquipNoButton" Content="No" Width="80" />
</StackPanel>


    <!-- Centered content wrapper -->
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20"
                Margin="0,100,0,0">

        <!-- Equipped score display -->
        <Border x:Name="EquippedScoreDisplay"
                Width="300" Height="170"
                Background="#555"
                CornerRadius="8"
                HorizontalAlignment="Center">
            <TextBlock x:Name="EquippedScoreText"
                       Text="Equipped Score"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White" />
        </Border>

        <!-- Horizontal placeholder rectangles -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="25"
                    Margin="0,60,0,0">
            <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
            <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
            <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
        </StackPanel>
    </StackPanel>

    <!-- Back button -->
    <Button x:Name="BackButtonTempoResonate" Content="Back"
            Width="200" Height="50"
            Background="White" Foreground="Black"
            FontSize="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Click="BackButtonTempoResonate_Click" />
</Grid>

        <views:UpgradeScreen x:Name="UpgradeScreen" IsVisible="False" />

        <!-- Fragmentation Screen -->
        <Grid x:Name="FragmentationScreen" IsVisible="False">
            <Grid.Background>
                <ImageBrush Source="avares://MusicClicker/Assets/FragmentationBG-min.png"
                    Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Top Title and Notes -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                Spacing="10">
                <TextBlock Text="Fragmentation" FontSize="36" FontWeight="Bold" Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="FragmentationNotesText" Text="Notes: 0" FontSize="28"
                    Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Fragment squares -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                VerticalAlignment="Center" Spacing="80">

                <!-- Melodious Fragments -->
                <Grid Width="260" Margin="0,30,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Melodious Fragments" FontSize="24"
                        FontWeight="Bold"
                        Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="1" x:Name="MelodiousFragmentButton" Width="200" Height="200"
                        HorizontalAlignment="Center">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game Assets [F503F6F]-min.png"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock Grid.Row="2" Text="1000 Notes for 1" FontSize="20" Foreground="White"
                        HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" x:Name="MelodiousOwnedText" Text="0 Owned" FontSize="20"
                        Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>

                <!-- Harmonious Fragments -->
                <Grid Width="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Harmonious Fragments" FontSize="24"
                        FontWeight="Bold"
                        Foreground="Black" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="1" x:Name="HarmoniousFragmentButton" Width="200" Height="200"
                        HorizontalAlignment="Center">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game Assets [0EE1949]-min.png"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock Grid.Row="2" Text="5000 Notes for 1" FontSize="20" Foreground="White"
                        HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" x:Name="HarmoniousOwnedText" Text="0 Owned"
                        FontSize="20"
                        Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <!-- Back Button -->
            <Button x:Name="BackButtonFragmentation" Content="Back" Width="200" Height="50"
                Background="White" Foreground="Black" FontSize="20"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
        </Grid>

        <!-- Save the Scores Screen -->
        <Grid x:Name="SaveScoresScreen" IsVisible="False">
            <Grid.Background>
                <ImageBrush Source="avares://MusicClicker/Assets/Soul Menu 2-min.png"
                    Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Screen Title and Notes Owned -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                Spacing="10">
                <TextBlock Text="Soul Resonance" FontSize="36" FontWeight="Bold" Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="SaveScoresNotesText" Text="Notes: 0" FontSize="28"
                    Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Scrollable Scores Section -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="20,120,20,80" Background="Transparent">
                <!-- Margin adjusted to start below title + notes -->
                <StackPanel Orientation="Vertical" Spacing="20">

                    <!-- Moonlight Sonata -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" /> <!-- Button width -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="MoonlightSonataButton" Margin="5" Width="384"
                                Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [BC3B44D]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="5000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="MoonlightMinorKeysText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="MoonlightMinorScalesText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="MoonlightMinorProgressionsText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="MoonlightMajorSheetsText" FontSize="16"
                                    Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Eroica -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="EroicaButton" Margin="5" Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [9B5FF4F]-min.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="15000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="EroicaMinorKeysText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="EroicaMinorScalesText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="EroicaMinorProgressionsText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="EroicaMajorSheetsText" FontSize="16"
                                    Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Swan Lake -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SwanLakeButton" Margin="5" Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [AA78ED8].png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="45000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="SwanLakeMinorKeysText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="SwanLakeMinorScalesText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="SwanLakeMinorProgressionsText" FontSize="16"
                                    Foreground="White" />
                                <TextBlock x:Name="SwanLakeMajorSheetsText" FontSize="16"
                                    Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- La Campanella -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="LaCampanellaButton" Margin="5" Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/SoulOfLaCampanella.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="135,000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="LaCampanellaMinorKeysText"
                                    Text="Minor key of La Campanella"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="LaCampanellaMinorScalesText"
                                    Text="Minor scales of La Campanella"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="LaCampanellaMinorProgressionsText"
                                    Text="Minor progressions of La Campanella"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="LaCampanellaMajorSheetsText"
                                    Text="Major sheets of La Campanella"
                                    FontSize="16" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Enigma -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="EnigmaButton" Margin="5" Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/SoulOfEnigma.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="405,000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="EnigmaMinorKeysText" Text="Minor key of Enigma"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="EnigmaMinorScalesText"
                                    Text="Minor scales of Enigma"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="EnigmaMinorProgressionsText"
                                    Text="Minor progressions of Enigma"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="EnigmaMajorSheetsText"
                                    Text="Major sheets of Enigma"
                                    FontSize="16" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fate -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="FateButton" Margin="5" Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/SoulOfFate.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="1,215,000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="FateMinorKeysText" Text="Minor key of Fate"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="FateMinorScalesText" Text="Minor scales of Fate"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="FateMinorProgressionsText"
                                    Text="Minor progressions of Fate"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="FateMajorSheetsText" Text="Major sheets of Fate"
                                    FontSize="16" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ode to Joy -->
                    <Border Background="#00000000" Height="220" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="384" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="OdeToJoyButton" Margin="5" Width="384" Height="216"
                                Background="Transparent" BorderThickness="0">
                                <Image
                                    Source="avares://MusicClicker/Assets/SoulOfOdeToJoy.png"
                                    Stretch="UniformToFill" Width="384" Height="216" />
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15"
                                Spacing="5">
                                <TextBlock Text="3,645,000 Notes for Soul Resonance" FontSize="20"
                                    Foreground="White" />
                                <TextBlock x:Name="OdeToJoyMinorKeysText"
                                    Text="Minor key of Ode to Joy"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="OdeToJoyMinorScalesText"
                                    Text="Minor scales of Ode to Joy"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="OdeToJoyMinorProgressionsText"
                                    Text="Minor progressions of Ode to Joy"
                                    FontSize="16" Foreground="White" />
                                <TextBlock x:Name="OdeToJoyMajorSheetsText"
                                    Text="Major sheets of Ode to Joy"
                                    FontSize="16" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>


                </StackPanel>
            </ScrollViewer>

            <!-- Back Button -->
            <Button x:Name="BackButtonSaveScores" Content="Back" Width="200" Height="50"
                Background="White" Foreground="Black" FontSize="20"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
        </Grid>

        <!-- Heart of Harmony Screen -->
        <Grid x:Name="HeartOfHarmonyScreen" IsVisible="False">
            <Grid.Background>
                <ImageBrush
                    Source="avares://MusicClicker/Assets/sacredtrevor_A_ray_of_light_shining_down_onto_a_pink_and_red_wi_d8fbd6c8-2ca7-4ae7-91b0-4c2dd7c79ff4-min.png"
