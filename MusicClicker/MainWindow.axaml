                                    Content="Freezing Harmony (Freeze NPS)"
                                    Click="MainFreezingHarmonyButton_Click"
                                    FontSize="11"
                                    Padding="8,4"
                                    IsEnabled="False" />
                        </StackPanel>
                        
                        <!-- Second Row: Eternal Frost + Regal Snowlight -->
