<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MusicClicker.MainWindow"
    Title="🌹🎹 Magnum Opus 🎹🌹"
    Width="1600" Height="900">

    <Window.Background>
        <ImageBrush
            Source="avares://MusicClicker/Assets/sacredtrevor_A_grand_musical_city_lights_everywhere_popular_shi_d84ff662-c87b-4630-9887-25228f42097b-min.png"
            Stretch="UniformToFill" />
    </Window.Background>

    <Grid>
        <!-- Main Screen -->
        <Grid x:Name="MainScreen">
            <!-- Main Grid Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Left navigation buttons -->
                    <ColumnDefinition Width="*" />    <!-- Main clicker content -->
                    <ColumnDefinition Width="Auto" /> <!-- Right side buttons -->
                </Grid.ColumnDefinitions>

                <!-- Right side buttons -->
<StackPanel Grid.Column="2"
            Orientation="Vertical"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,10,30,0"
            Spacing="10">

    <!-- Tempo Resonate Button -->
    <Button x:Name="TempoResonateButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/TempoResonate.png"
               Stretch="UniformToFill" />
    </Button>

    <!-- Eternal Modulation Button -->
    <Button x:Name="EternalModulationButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/EternalModulation.png"
               Stretch="UniformToFill" />
    </Button>

    <!-- Armor of Forte Button -->
    <Button x:Name="ArmorOfForteButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/ArmoryofForte.png"
               Stretch="UniformToFill" />
    </Button>

    <!-- Symphonic Gallery Button -->
    <Button x:Name="SymphonicGalleryButton" Width="300" Height="170">
        <Image Source="avares://MusicClicker/Assets/SymphonicGallery.png"
               Stretch="UniformToFill" />
    </Button>
</StackPanel>
                <!-- Left side buttons -->
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="30,10,0,0" Spacing="10">
                    <Button x:Name="FragmentationButton" Width="300" Height="170">
                        <Image Source="avares://MusicClicker/Assets/Fragmentation Button-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="ResonanceButton" Width="300" Height="170">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [C690BBF]-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="MelodyButton" Width="300" Height="170">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [2299EA4]-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                    <Button x:Name="HarmonyButton" Width="300" Height="170">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [5A28B4B]-min.png"
                            Stretch="UniformToFill" />
                    </Button>
                </StackPanel>

                <!-- Content Grid - Kept at left position but everything centered within it -->
                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="50,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Title and Notes -->
                        <RowDefinition Height="Auto" /> <!-- Click Button -->
                        <RowDefinition Height="Auto" /> <!-- Upgrades Button -->
                        <RowDefinition Height="Auto" /> <!-- Essence Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title and Notes -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10"
                        Margin="0,0,0,30">
                        <TextBlock Text="🌹🎹 Magnum Opus 🎹🌹" FontSize="36" Foreground="White"
                            HorizontalAlignment="Center" FontWeight="Bold" />
                        <TextBlock x:Name="NotesText" Text="Notes: 0" FontSize="28"
                            Foreground="White"
                            HorizontalAlignment="Center" />
                        <TextBlock x:Name="NpsText" Text="Notes Per Second: 0" FontSize="22"
                            Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Main Click Button -->
                    <Button Grid.Row="1" x:Name="ClickButton" Width="200" Height="200"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game Assets [A961E2A]-min.png"
                            Stretch="Uniform" />
                    </Button>

                    <!-- Upgrades Button -->
                    <Button Grid.Row="2" x:Name="OpenUpgradesButton" Content="Upgrades"
                        Width="250" Height="50" Background="#55000000" Foreground="White"
                        FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,30" />

                    <!-- Essence Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Spacing="40" Margin="0,10,0,0">

                        <!-- Essence of Beethoven -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Beethoven" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssenceBeethovenButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game Assets [7EA44B0]-min.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="500 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssenceBeethovenOwnedText" Text="0 Owned"
                                FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Essence of Pyotr -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Pyotr" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssencePyotrButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/Music Game Assets [8895F90]-min.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="1500 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssencePyotrOwnedText" Text="0 Owned" FontSize="14"
                                Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Essence of Elgar -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Elgar" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssenceElgarButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/EssenceOfElgar.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="4000 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssenceElgarOwnedText" Text="0 Owned"
                                FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Essence of Liszt -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Essence of Liszt" FontSize="18" FontWeight="Bold"
                                Foreground="White" TextAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button x:Name="EssenceLisztButton" Width="140" Height="140"
                                Background="Transparent" BorderThickness="2"
                                HorizontalAlignment="Center">
                                <Image
                                    Source="avares://MusicClicker/Assets/EssenceOfLiszt.png"
                                    Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="6000 Notes" FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EssenceLisztOwnedText" Text="0 Owned"
                                FontSize="14" Foreground="White"
                                TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

<!-- Tempo Resonate Screen -->
<Grid x:Name="TempoResonateScreen" IsVisible="False">
    <Grid.Background>
        <ImageBrush Source="avares://MusicClicker/Assets/TempoResonateBG.png"
                    Stretch="UniformToFill" />
    </Grid.Background>

    <!-- Title -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
        <TextBlock Text="Tempo Resonate" FontSize="36" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Scrollable drawer on the left -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Width="280" Margin="20,100,0,20"
                  HorizontalAlignment="Left" VerticalAlignment="Stretch">
        <StackPanel x:Name="LeftDrawerPanel" Orientation="Vertical" Spacing="10" />
    </ScrollViewer>

    <!-- Equip prompt panel above equip image -->
<StackPanel x:Name="EquipPromptPanel"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsVisible="False"
            Spacing="10"
            Margin="0,150,0,0"> 
    <TextBlock x:Name="EquipPromptText"
               Text="Equip X?"
               Foreground="White"
               FontSize="20" />
    <Button x:Name="EquipYesButton" Content="Yes" Width="80" />
    <Button x:Name="EquipNoButton" Content="No" Width="80" />
</StackPanel>


    <!-- Centered content wrapper -->
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20"
                Margin="0,100,0,0">

        <!-- Equipped score display -->
        <Border x:Name="EquippedScoreDisplay"
                Width="300" Height="170"
                Background="#555"
                CornerRadius="8"
                HorizontalAlignment="Center">
            <TextBlock x:Name="EquippedScoreText"
                       Text="Equipped Score"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White" />
        </Border>

        <!-- Horizontal placeholder rectangles -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="25"
                    Margin="0,60,0,0">
            <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
            <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
            <Border Width="250" Height="160" Background="#333" CornerRadius="8"/>
        </StackPanel>
    </StackPanel>

    <!-- Back button -->
    <Button x:Name="BackButtonTempoResonate" Content="Back"
            Width="200" Height="50"
            Background="White" Foreground="Black"
            FontSize="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Click="BackButtonTempoResonate_Click" />
</Grid>

        <!-- Upgrade Screen -->
        <Grid x:Name="UpgradeScreen" IsVisible="False" Background="#AA000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,15,20,10"
                Spacing="8">
                <TextBlock Text="Upgrades" FontSize="32" FontWeight="Bold" Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="UpgradeNotesTextHeader" Text="Notes: 0" FontSize="22"
                    Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,160,0,80">
                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" ItemWidth="240"
                    ItemHeight="140">

                    <!-- Chord Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image
                                Source="avares://MusicClicker/Assets/MusicGameAssetsChord-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Chord" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="ChordOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="ChordCostTextUpgrade" Text="Cost: 10"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds 0.5 NPS" FontSize="12" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyChordButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyChordMaxButton" Content="Buy Max" Width="70"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scale Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image
                                Source="avares://MusicClicker/Assets/MusicGameAssetsScale-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Scale" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="ScaleOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="ScaleCostTextUpgrade" Text="Cost: 50"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds 3 NPS" FontSize="12" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyScaleButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyScaleMaxButton" Content="Buy Max" Width="70"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Orchestra Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image
                                Source="avares://MusicClicker/Assets/MusicGameAssetsOrchestra-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Orchestra" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="OrchestraOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="OrchestraCostTextUpgrade" Text="Cost: 100"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds 5 NPS" FontSize="12" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyOrchestraButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyOrchestraMaxButton" Content="Buy Max"
                                        Width="70" Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Symphony Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image
                                Source="avares://MusicClicker/Assets/MusicGameAssetsSymphony-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Symphony" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="SymphonyOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="SymphonyCostTextUpgrade" Text="Cost: 350"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds 9 NPS" FontSize="12" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuySymphonyButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuySymphonyMaxButton" Content="Buy Max"
                                        Width="70" Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Aria Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="avares://MusicClicker/Assets/MusicGameAssetsAria-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Aria" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="AriaOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="AriaCostTextUpgrade" Text="Cost: 350"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds +1 Note on Click" FontSize="12"
                                    Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyAriaButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyAriaMaxButton" Content="Buy Max" Width="70"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Requiem Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image
                                Source="avares://MusicClicker/Assets/MusicGameAssetsRequiem-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Requiem" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="RequiemOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="RequiemCostTextUpgrade" Text="Cost: 750"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds +2 Notes on Click" FontSize="12"
                                    Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyRequiemButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyRequiemMaxButton" Content="Buy Max"
                                        Width="70" Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Opus Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="avares://MusicClicker/Assets/MusicGameAssetsOpus-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Opus" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="OpusOwnedTextUpgrade" Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="OpusCostTextUpgrade" Text="Cost: 1500"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds +3 Notes on Click" FontSize="12"
                                    Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyOpusButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyOpusMaxButton" Content="Buy Max" Width="70"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Magnum Opus Upgrade -->
                    <Border Background="Black" BorderBrush="White" BorderThickness="2" Padding="6"
                        Width="240" Height="140" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image
                                Source="avares://MusicClicker/Assets/MusicGameAssetsMagnumOpus-min.png"
                                Width="50" Height="50" Stretch="UniformToFill" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Magnum Opus" FontSize="16" FontWeight="Bold"
                                    Foreground="White" />
                                <TextBlock x:Name="MagnumOpusOwnedTextUpgrade"
                                    Text="Number Owned: 0"
                                    FontSize="12" Foreground="White" />
                                <TextBlock x:Name="MagnumOpusCostTextUpgrade" Text="Cost: 3000"
                                    FontSize="12" Foreground="White" />
                                <TextBlock Text="Adds +4 Notes on Click" FontSize="12"
                                    Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button x:Name="BuyMagnumOpusButton" Content="Buy 1" Width="60"
                                        Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                    <Button x:Name="BuyMagnumOpusMaxButton" Content="Buy Max"
                                        Width="70" Height="26"
                                        Background="Black" Foreground="White" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </ScrollViewer>

            <Button x:Name="BackButtonBottom" Content="Back" Width="200" Height="50"
                Background="White" Foreground="Black" FontSize="20"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
        </Grid>

        <!-- Fragmentation Screen -->
        <Grid x:Name="FragmentationScreen" IsVisible="False">
            <Grid.Background>
                <ImageBrush Source="avares://MusicClicker/Assets/FragmentationBG-min.png"
                    Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Top Title and Notes -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                Spacing="10">
                <TextBlock Text="Fragmentation" FontSize="36" FontWeight="Bold" Foreground="White"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="FragmentationNotesText" Text="Notes: 0" FontSize="28"
                    Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Fragment squares -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                VerticalAlignment="Center" Spacing="80">

                <!-- Melodious Fragments -->
                <Grid Width="260" Margin="0,30,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Melodious Fragments" FontSize="24"
                        FontWeight="Bold"
                        Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="1" x:Name="MelodiousFragmentButton" Width="200" Height="200"
                        HorizontalAlignment="Center">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game Assets [F503F6F]-min.png"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock Grid.Row="2" Text="1000 Notes for 1" FontSize="20" Foreground="White"
                        HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" x:Name="MelodiousOwnedText" Text="0 Owned" FontSize="20"
                        Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>

                <!-- Harmonious Fragments -->
                <Grid Width="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Harmonious Fragments" FontSize="24"
                        FontWeight="Bold"
                        Foreground="Black" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="1" x:Name="HarmoniousFragmentButton" Width="200" Height="200"
                        HorizontalAlignment="Center">
                        <Image
                            Source="avares://MusicClicker/Assets/Music Game Assets [0EE1949]-min.png"
                            Stretch="Uniform" />
                    </Button>
