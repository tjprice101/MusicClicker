                    <!-- Clair de Lune Stack Display -->
                    <StackPanel x:Name="MainClairDeLuneStackPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,6,0,0"
                                IsVisible="False">
                        <!-- Time-Based System Info -->
                        <TextBlock Text="Clockwork Symphony - Time-Based Effects"
                                   Foreground="#FFD700"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        
                        <!-- Temporal Stacks Display -->
                        <StackPanel Orientation="Horizontal" Spacing="25" HorizontalAlignment="Center">
                            <!-- Shattered Moonlight -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Shattered Moonlight"
                                           Foreground="#B0C4DE"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
