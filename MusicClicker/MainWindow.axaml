<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MusicClicker.Views"
        x:Class="MusicClicker.MainWindow"
        Title="Magnum Opus"
        Width="1600" Height="900">

    <Window.Styles>
        <!-- Shrink effect for all buttons except specific exclusions -->
        <Style Selector="Button:not(#FragmentationButton):not(#ResonanceButton):not(#MelodyButton):not(#HarmonyButton):not(#TempoResonateButton):not(#EternalModulationButton):not(#ArmoryOfForteButton):not(#SymphonicGalleryButton):not(#ClickButton):not(#BackButton):not(#BackButtonSaveScores):not(#BackButtonHeartOfHarmony):not(#BackButtonFragmentation):not(#BackButtonUnitySymphony):not(#BackButtonBottom):not(#MercuryChallengeButton):not(#TonalityChallengeButton):not(#MarsChallengeButton):not(#GiveUpButton):not(#BuyChordButton):not(#BuyChordMaxButton):not(#BuyScaleButton):not(#BuyScaleMaxButton):not(#BuyOrchestraButton):not(#BuyOrchestraMaxButton):not(#BuySymphonyButton):not(#BuySymphonyMaxButton):not(#BuyAriaButton):not(#BuyAriaMaxButton):not(#BuyRequiemButton):not(#BuyRequiemMaxButton):not(#BuyOpusButton):not(#BuyOpusMaxButton):not(#BuyMagnumOpusButton):not(#BuyMagnumOpusMaxButton)">
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button:not(#FragmentationButton):not(#ResonanceButton):not(#MelodyButton):not(#HarmonyButton):not(#TempoResonateButton):not(#EternalModulationButton):not(#ArmoryOfForteButton):not(#SymphonicGalleryButton):not(#ClickButton):not(#BackButton):not(#BackButtonSaveScores):not(#BackButtonHeartOfHarmony):not(#BackButtonFragmentation):not(#BackButtonUnitySymphony):not(#BackButtonBottom):not(#MercuryChallengeButton):not(#TonalityChallengeButton):not(#MarsChallengeButton):not(#GiveUpButton):not(#BuyChordButton):not(#BuyChordMaxButton):not(#BuyScaleButton):not(#BuyScaleMaxButton):not(#BuyOrchestraButton):not(#BuyOrchestraMaxButton):not(#BuySymphonyButton):not(#BuySymphonyMaxButton):not(#BuyAriaButton):not(#BuyAriaMaxButton):not(#BuyRequiemButton):not(#BuyRequiemMaxButton):not(#BuyOpusButton):not(#BuyOpusMaxButton):not(#BuyMagnumOpusButton):not(#BuyMagnumOpusMaxButton):pointerover">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        
        <!-- ClickButton shrinks very slightly on press -->
        <Style Selector="Button#ClickButton">
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button#ClickButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
    </Window.Styles>

    <Window.Background>
        <ImageBrush
            Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/sacredtrevor_A_grand_musical_city_lights_everywhere_popular_shi_d84ff662-c87b-4630-9887-25228f42097b-min.png"
            Stretch="UniformToFill" />
    </Window.Background>

    <Grid>
        <!-- Main Screen -->
        <Grid x:Name="MainScreen" ZIndex="1">
            <!-- Grid Structure -->
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />     <!-- Top Bar -->
                <RowDefinition Height="40" />      <!-- Spacer to lower panels -->
                <RowDefinition Height="*" />       <!-- Main Content Area -->
                <RowDefinition Height="Auto" />    <!-- Crescendance Panel -->
                <RowDefinition Height="155" />     <!-- Bottom Button Bar -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />   <!-- Left Panel (slightly wider) -->
                <ColumnDefinition Width="*" />     <!-- Center Area -->
                <ColumnDefinition Width="280" />   <!-- Right Panel (slightly wider) -->
            </Grid.ColumnDefinitions>

            <!-- ==================== TOP BAR (Row 0, All Columns) ==================== -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                    Background="#66000000" 
                    CornerRadius="8" 
                    Margin="12,12,12,0"
                    BorderBrush="#FFFF69B4"
                    BorderThickness="3">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Save Button and Feedback Button (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <Border CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.7" OffsetX="0" OffsetY="0" />
                                </Border.Effect>
                                <Button x:Name="TopSaveButton"
                                        Width="170"
                                        Height="85"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/SaveIcon.png"
                                           Stretch="Uniform" IsHitTestVisible="False" />
                                </Button>
                            </Border>
                            <TextBlock x:Name="SaveStatusText"
                                       Text=""
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        
                        <Border CornerRadius="8" VerticalAlignment="Top" Margin="0,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.7" OffsetX="0" OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="FeedbackButton"
                                    Width="142"
                                    Height="80"
                                    Background="White"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Padding="0">
                                <TextBlock Text="Feedback"
                                           Foreground="Black"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Border>
                        
                        <Border CornerRadius="8" VerticalAlignment="Top" Margin="0,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.7" OffsetX="0" OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="QuitButton"
                                    Width="142"
                                    Height="80"
                                    Background="#8B0000"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Padding="0">
                                <TextBlock Text="Save and Quit"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Stats Display (Center) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Magnum Opus"
                                   FontSize="24"
                                   Foreground="#FFFF69B4"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                            <TextBlock x:Name="NotesText"
                                       Text="Notes: 0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock x:Name="NpsText"
                                       Text="NPS: 0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Upgrades Button (Right) -->
                    <Border Grid.Column="2" CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.7" OffsetX="0" OffsetY="0" />
                        </Border.Effect>
                        <Button x:Name="TopOpenUpgradesButton" 
                                Width="170" 
                                Height="85" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/UpgradeMenu.png" 
                                   Stretch="Uniform" 
                                   IsHitTestVisible="False" />
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== LEFT PANEL (Row 2, Column 0) ==================== -->
            <Border Grid.Row="2" Grid.Column="0" 
                    Background="#66000000"
                    BorderBrush="#FFFF69B4"
                    BorderThickness="3"
                    CornerRadius="8"
                    Margin="12,8,6,8"
                    ZIndex="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="6" Margin="10">
                        <!-- Fragmentation Button -->
                        <Button x:Name="FragmentationButton"
                                Width="231"
                                Height="130"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                PointerEntered="ShowButtonTooltip"
                                PointerExited="HideButtonTooltip"
                                PointerMoved="UpdateTooltipPosition"
                                Tag="Acquire pieces of Minor musical scores here!">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/Fragmentation Button-min.png"
                                   Stretch="Uniform" />
                        </Button>

                        <!-- Resonance Button -->
                        <Button x:Name="ResonanceButton"
                                Width="231"
                                Height="130"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                PointerEntered="ShowButtonTooltip"
                                PointerExited="HideButtonTooltip"
                                PointerMoved="UpdateTooltipPosition"
                                Tag="Resonate with any owned Major Score and select your instrumental weaponry to activate their unique connection to music.">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game 16_9 Assets [C690BBF]-min.png"
                                   Stretch="Uniform" />
                        </Button>

                        <!-- Melody Button -->
                        <Button x:Name="MelodyButton"
                                Width="231"
                                Height="130"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                PointerEntered="ShowButtonTooltip"
                                PointerExited="HideButtonTooltip"
                                PointerMoved="UpdateTooltipPosition"
                                Tag="Consume Major Sheets here to obtain pieces for powerful Major versions of the Minor Scores!">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game 16_9 Assets [2299EA4]-min.png"
                                   Stretch="Uniform" />
                        </Button>

                        <!-- Harmony Button -->
                        <Button x:Name="HarmonyButton"
                                Width="231"
                                Height="130"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                PointerEntered="ShowButtonTooltip"
                                PointerExited="HideButtonTooltip"
                                PointerMoved="UpdateTooltipPosition"
                                Tag="Bring it all together by combining the pieces of Minor and Major scores (separately) to acquire the compositions themselves to help boost you!">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game 16_9 Assets [5A28B4B]-min.png"
                                   Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== CENTER AREA (Row 2, Column 1) ==================== -->
            <Grid Grid.Row="2" Grid.Column="1" Margin="6,8">
                <!-- Click Button -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="75">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.7" OffsetX="0" OffsetY="0" />
                    </Border.Effect>
                    <Button x:Name="ClickButton"
                            Width="220"
                            Height="220"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            PointerMoved="ClickButton_PointerMoved">
                        <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/Backgrounds &amp; Generic/Music Game Assets [A961E2A]-min.png"
                               Stretch="Uniform" IsHitTestVisible="False" />
                    </Button>
                </Border>
                
                <!-- Prayer Stacks Display (Funeral Prayer) -->
                <Border x:Name="PrayerStacksDisplayBorder"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Background="#DD1a1a2e"
                        BorderBrush="#FF8B0000"
                        BorderThickness="2"
                        Padding="12,8"
                        Margin="0,0,40,0"
                        IsVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#8B0000" BlurRadius="15" Opacity="0.7" OffsetX="0" OffsetY="0" />
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <TextBlock Text="Prayer Stacks"
                                   Foreground="#FFFF6B6B"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="PrayerStacksText"
                                   Text="0 / 3"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                
                <!-- Sparkle particle canvas for click effects -->
                <Canvas x:Name="SparkleParticleCanvas"
                        IsHitTestVisible="False"
                        ZIndex="250" />
                
                <!-- Floating text canvas for click feedback -->
                <Canvas x:Name="FloatingTextCanvas"
                        IsHitTestVisible="False"
                        ZIndex="300" />
                
                <!-- Hover Tooltip -->
                <Border x:Name="HoverTooltip"
                        Background="Black"
                        BorderBrush="White"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="12,8"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        ZIndex="400">
                    <TextBlock x:Name="HoverTooltipText"
                               Text=""
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxWidth="400" />
                </Border>
            </Grid>

            <!-- ==================== RIGHT PANEL (Row 2, Column 2) ==================== -->
            <Border Grid.Row="2" Grid.Column="2"
                    Background="#66000000"
                    BorderBrush="#FFFF69B4"
                    BorderThickness="3"
                    CornerRadius="8"
                    Margin="6,8,12,8"
                    ZIndex="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="6" Margin="10">
                        <!-- Duet Ability Button -->
                        <Button x:Name="OpenDuetAbilityButton" 
                                Width="231"
                                Height="130"
                                Background="Transparent" 
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                IsVisible="False">
                            <Image x:Name="DuetAbilityButtonImage"
                                   Stretch="Uniform" />
                        </Button>

                        <!-- Tempo Resonate Button -->
                        <Button x:Name="TempoResonateButton"
                                Width="231"
                                Height="130"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                PointerEntered="ShowButtonTooltip"
                                PointerExited="HideButtonTooltip"
                                PointerMoved="UpdateTooltipPosition"
                                Tag="Resonate with any owned Major Score and select your instrumental weaponry to activate their unique connection to music.">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/TempoResonate.png"
                                   Stretch="Uniform" />
                        </Button>

                        <!-- Eternal Modulation Button -->
                        <Button x:Name="EternalModulationButton"
                                Width="231"
                                Height="130"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                PointerEntered="ShowButtonTooltip"
                                PointerExited="HideButtonTooltip"
                                PointerMoved="UpdateTooltipPosition"
                                Tag="Take part in the currently active events to acquire limited time scores! The costs of these scores scales with your Notes Per Second and your Notes Per Click!">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/EternalModulation.png"
                                   Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== BOTTOM BAR (Row 4, All Columns) ==================== -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#66000000"
                    BorderBrush="#FFFF69B4"
                    BorderThickness="3"
                    CornerRadius="8"
                    Margin="12,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Margin="10">
                    <!-- Cacophonic Dreams Button -->
                    <Border CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.8" OffsetX="0" OffsetY="0" />
                        </Border.Effect>
                        <Grid Width="240" Height="135">
                            <Button x:Name="CacophonicDreamsButton"
                                    Width="240"
                                    Height="135"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    IsEnabled="False"
                                    Opacity="0.4">
                                <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/CacophonicDreamsBUTTON.jpg"
                                       Stretch="UniformToFill" />
                            </Button>
                            
                            <!-- Lock overlay -->
                            <Border x:Name="CacophonicDreamsLockOverlay"
                                    Background="#AA000000"
                                    CornerRadius="6"
                                    Width="240"
                                    Height="135"
                                    IsVisible="True">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock Text="🔒" FontSize="16" HorizontalAlignment="Center" Foreground="White" />
                                    <TextBlock x:Name="CacophonicDreamsLockText"
                                               Text="Locked"
                                               Foreground="White"
                                               FontSize="9"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Armory of Forte Button -->
                    <Border CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.8" OffsetX="0" OffsetY="0" />
                        </Border.Effect>
                        <Button x:Name="ArmoryOfForteButton"
                                Width="240"
                                Height="135"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/ArmoryofForte.png"
                                   Stretch="Uniform" />
                        </Button>
                    </Border>

                    <!-- Symphonic Gallery Button -->
                    <Border CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.8" OffsetX="0" OffsetY="0" />
                        </Border.Effect>
                        <Button x:Name="SymphonicGalleryButton"
                                Width="240"
                                Height="135"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Image Source="avares://MusicClicker/Gameplay Components/Resources/Assets/UI Buttons &amp; Menus/SymphonicGallery.png"
                                   Stretch="Uniform" />
                        </Button>
                    </Border>

                    <!-- Bottom Fragmentation Button removed (duplicate) -->
                </StackPanel>
            </Border>

            <!-- Hidden OpenUpgradesButton for backward compatibility -->
            <Button x:Name="OpenUpgradesButton" IsVisible="False" Width="0" Height="0" />

            <!-- ==================== CRESCENDANCE & DUET ROW (Row 3, Left and Right) ==================== -->
            <!-- Crescendance Panel - Left Side -->
            <Border x:Name="MainScreenCrescendancePanel"
                    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#DD000000"
                    BorderBrush="#FFFF69B4"
                    BorderThickness="3"
                    CornerRadius="8"
                    Padding="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12,0,6,12"
                    Width="750"
                    MaxHeight="180"
                    IsVisible="False"
                    ZIndex="400">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" Spacing="6">
                    <TextBlock x:Name="MainCrescendanceTitle"
                               Text="Crescendance: [Score Name]"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                    
                    <TextBlock x:Name="MainCrescendanceInfoText"
                               Text="Crescendance information will appear here."
                               FontSize="14"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="700">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.7" />
                        </TextBlock.Effect>
                    </TextBlock>
                    
                    <!-- Swan Lake Feather Display -->
                    <StackPanel x:Name="MainSwanFeatherPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="15"
                                Margin="0,6,0,0"
                                IsVisible="False">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Revered Feathers"
                                       Foreground="LightBlue"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainReveredFeatherCount"
                                       Text="0 / 5"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="MainConsumeReveredButton"
                                    Content="Consume (+ 20% Notes)"
                                    FontSize="11"
                                    Padding="6,3"
                                    IsEnabled="False" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Chromatic Feathers"
                                       Foreground="Violet"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainChromaticFeatherCount"
                                       Text="0 / 10"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="MainConsumeChromaticButton"
                                    Content="Consume (+2 All Minors)"
                                    FontSize="11"
                                    Padding="6,3"
                                    IsEnabled="False" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Polyphonic Feathers"
                                       Foreground="Gold"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainPolyphonicFeatherCount"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="MainConsumePolyphonicButton"
                                    Content="Consume (+83 Entropic Melodies +75% Notes)"
                                    FontSize="11"
                                    Padding="6,3"
                                    IsEnabled="False" />
                            <TextBlock x:Name="MainThousandWingTimerText"
                                       Text=""
                                       Foreground="#C71585"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"
                                       IsVisible="False" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Moonlight Sonata Stack Display -->
                    <StackPanel x:Name="MainMoonlightStackPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="25"
                                Margin="0,6,0,0"
                                IsVisible="False">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Moonbeam Resonance"
                                       Foreground="LightBlue"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainMoonbeamResonanceCount"
                                       Text="0 / 5"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="(Auto-consumes at 8 stacks)"
                                       Foreground="Gray"
                                       FontSize="10"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Harmonizing Moonlight"
                                       Foreground="Gold"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainHarmonizingMoonlightCount"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="(Consumed by Eulogy weapon)"
                                       Foreground="Gray"
                                       FontSize="10"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="ConsumeHarmonizingMoonlightButton"
                                    Content="Consume (1 Harmonizing → 3 Moonbeam + Components)"
                                    HorizontalAlignment="Center"
                                    Padding="8,4"
                                    Margin="0,4,0,0"
                                    Background="#e94560"
                                    Foreground="White"
                                    FontSize="11"
                                    CornerRadius="8"
                                    IsVisible="False"
                                    Click="ConsumeHarmonizingMoonlight_Click" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- La Campanella Stack Display -->
                    <StackPanel x:Name="MainLaCampanellaStackPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,6,0,0"
                                IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
