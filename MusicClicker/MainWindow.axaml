                    </StackPanel>

                    <!-- Mercury Crescendance: The Winged Messenger -->
                    <StackPanel x:Name="MainMercuryCrescendancePanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,6,0,0"
                                IsVisible="False">
                        <!-- Mercury System Info -->
                        <TextBlock Text="The Winged Messenger - Herald of Fate"
                                   Foreground="#87CEEB"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        
                        <!-- Mercury Stacks Display -->
                        <StackPanel Orientation="Horizontal" Spacing="25" HorizontalAlignment="Center">
                            <!-- Swift Resonance -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Swift Resonance"
                                           Foreground="#87CEEB"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainSwiftResonanceCount"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="(Passive)"
                                           Foreground="#A9A9A9"
                                           FontSize="9"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            
                            <!-- Herald's Message -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Herald's Message"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainHeraldsMessageCount"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="(Transform)"
                                           Foreground="#A9A9A9"
                                           FontSize="9"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            
                            <!-- Planetary Alignment -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Planetary Alignment"
                                           Foreground="#C0C0C0"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainPlanetaryAlignmentCount"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="(Bond)"
                                           Foreground="#A9A9A9"
                                           FontSize="9"
                                           HorizontalAlignment="Center" />
                                <Button x:Name="MainConsumePlanetaryAlignmentButton"
                                        Content="Consume (5 Crits)"
                                        Click="MainConsumePlanetaryAlignment_Click"
                                        Background="#708090"
                                        Foreground="White"
                                        FontSize="10"
                                        Padding="8,4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Mercury Ability Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="MainMercuryHeraldDescentButton"
                                    Content="Herald's Descent (15s CD)"
                                    Click="MainMercuryHeraldDescent_Click"
                                    Background="#4682B4"
                                    Foreground="White"
                                    FontSize="11"
                                    Padding="12,6" />
                            <Button x:Name="MainMercuryResonantTransformationButton"
                                    Content="Resonant Transformation"
                                    Click="MainMercuryResonantTransformation_Click"
                                    Background="#87CEEB"
                                    Foreground="Black"
                                    FontSize="11"
                                    Padding="12,6" />
                            <Button x:Name="MainMercurySymphonysBountyButton"
                                    Content="Symphony's Bounty"
                                    Click="MainMercurySymphonysBounty_Click"
                                    Background="White"
                                    Foreground="Black"
                                    FontSize="11"
                                    Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Mars Crescendance: Blade of Symphonic War -->
                    <StackPanel x:Name="MainMarsCrescendancePanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,6,0,0"
                                IsVisible="False">
                        <!-- Mars System Info -->
                        <TextBlock Text="Blade of Symphonic War"
                                   Foreground="#8B0000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        
                        <!-- Blade Charge Display -->
                        <TextBlock x:Name="MainBladeChargeText"
                                   Text="Blade Charge: 0.0%"
                                   Foreground="#FFD700"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        
                        <!-- Mars Stacks Display -->
                        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                            <!-- Resolute Fractal -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Resolute Fractal"
                                           Foreground="#DC143C"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainResoluteFractalCount"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <Button x:Name="MainConsumeResoluteFractalButton"
                                        Content="Consume (5× Notes)"
                                        Click="MainConsumeResoluteFractal_Click"
                                        Background="#8B0000"
                                        Foreground="White"
                                        FontSize="10"
                                        Padding="8,4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0" />
                                <Button x:Name="MainConsumeAllResoluteFractalButton"
                                        Content="Consume All"
                                        Click="MainConsumeAllResoluteFractal_Click"
                                        Background="#660000"
                                        Foreground="White"
                                        FontSize="9"
                                        Padding="6,3"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0" />
                            </StackPanel>
                            
                            <!-- Infinite War Counter -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Infinite War!!!"
                                           Foreground="#FFD700"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="MainInfiniteWarCount"
                                           Text="0"
                                           Foreground="#FFD700"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Critical Hits"
                                           Foreground="#FFA500"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                                <Button x:Name="MainMergeAllInfiniteWarButton"
                                        Content="Merge All"
                                        Click="MainMergeAllInfiniteWar_Click"
                                        Background="#8B4513"
                                        Foreground="White"
                                        FontSize="9"
                                        Padding="6,3"
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0" />
                            </StackPanel>
                            
                            <!-- Oblivion's Destruction -->
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock Text="Oblivion's Destruction"
                                           Foreground="#1C1C1C"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="8" Opacity="1.0" OffsetX="0" OffsetY="0" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="MainOblivionsDestructionCount"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <Button x:Name="MainConsumeOblivionsDestructionButton"
                                        Content="Consume (5 → +30 Minors)"
                                        Click="MainConsumeOblivionsDestruction_Click"
                                        Background="#2F4F4F"
                                        Foreground="White"
                                        FontSize="10"
                                        Padding="8,4"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Duet Ability Panel - Right Side (same row as Crescendance) -->
            <Border x:Name="DuetAbilityPanelContainer"
                    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#DD000000"
                    BorderBrush="#FFFF69B4"
                    BorderThickness="3"
                    CornerRadius="8"
                    Padding="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="6,0,12,12"
                    Width="750"
                    MaxHeight="180"
                    IsVisible="False"
                    ZIndex="400">
                <views:DuetAbilityScreen x:Name="DuetAbilityScreen" />
            </Border>
        </Grid>

        <!-- Game Screens -->
        <views:TempoResonateScreen x:Name="TempoResonateScreen" IsVisible="False" />
        <views:UpgradeScreen x:Name="UpgradeScreen" IsVisible="False" />
        <views:FragmentationScreen x:Name="FragmentationScreen" IsVisible="False" />
        <views:SaveScoresScreen x:Name="SaveScoresScreen" IsVisible="False" />
        <views:HeartOfHarmonyScreen x:Name="HeartOfHarmonyScreen" IsVisible="False" />
        <views:UniteTheSymphonyScreen x:Name="UnityTheSymphonyScreen" IsVisible="False" />
        <views:ArmoryOfForteScreen x:Name="ArmoryOfForteScreen" IsVisible="False" />
        <views:EntropicArmoryScreen x:Name="EntropicArmoryScreen" IsVisible="False" />
        <views:EternalModulationScreen x:Name="EternalModulationScreen" IsVisible="False" />
        
        <!-- Currently Active Events. Comment out any events that are not currently active in sets of 2. (Top = left and bottom = right) -->
        <views:DiesIraeEventScreen x:Name="DiesIraeEventScreen" IsVisible="False" />
        <views:WinterEventScreen x:Name="WinterEventScreen" IsVisible="False" />

        <views:SymphonicGalleryScreen x:Name="SymphonicGalleryScreen" IsVisible="False" />
        <views:ClickerCustomizeScreen x:Name="ClickerCustomizeScreen" IsVisible="False" />
        <views:BackgroundCustomizeScreen x:Name="BackgroundCustomizeScreen" IsVisible="False" />
        <views:CacophonicDreamsScreen x:Name="CacophonicDreamsScreen" IsVisible="False" />
        
        <!-- Dynamic Ambient Overlays for Major Scores (generated in code-behind) -->
        <!-- Moonlight Sonata - Dynamic moonbeams generated on resonate -->
        <Canvas x:Name="MoonlightBeamOverlay" IsVisible="False" IsHitTestVisible="False" ZIndex="450" Opacity="0.8"/>
        
        <!-- Swan Lake - Dynamic feather effects -->
        <Canvas x:Name="SwanFeatherOverlay" IsVisible="False" IsHitTestVisible="False" ZIndex="451" Opacity="0.7"/>
        
        <!-- Eroica - Dynamic cherry blossom petals -->
        <Canvas x:Name="EroicaPetalOverlay" IsVisible="False" IsHitTestVisible="False" ZIndex="452" Opacity="0.7"/>
        
        <!-- La Campanella - Dynamic bell effects -->
        <Canvas x:Name="LaCampanellaBellOverlay" IsVisible="False" IsHitTestVisible="False" ZIndex="453" Opacity="0.7"/>
        
        <!-- Mars War Flame Overlay - Black and red flame effect around screen edges -->
        <Grid x:Name="MarsFlameOverlay" IsVisible="False" IsHitTestVisible="False" ZIndex="500">
            <!-- Top edge flames - stretches full width -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="120" Opacity="0.7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#99550000" Offset="0.3"/>
                        <GradientStop Color="#66880000" Offset="0.6"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Bottom edge flames - stretches full width -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="120" Opacity="0.7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#99550000" Offset="0.3"/>
                        <GradientStop Color="#66880000" Offset="0.6"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Left edge flames - stretches full height -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="100" Opacity="0.7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#99550000" Offset="0.3"/>
                        <GradientStop Color="#66880000" Offset="0.6"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Right edge flames - stretches full height -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="100" Opacity="0.7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,0%">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#99550000" Offset="0.3"/>
                        <GradientStop Color="#66880000" Offset="0.6"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Corner intensifiers (black/red corners) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="180" Height="180" Opacity="0.6">
                <Border.Background>
                    <RadialGradientBrush Center="0%,0%" GradientOrigin="0%,0%">
                        <GradientStop Color="#EE000000" Offset="0"/>
                        <GradientStop Color="#AA550000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="180" Height="180" Opacity="0.6">
                <Border.Background>
                    <RadialGradientBrush Center="100%,0%" GradientOrigin="100%,0%">
                        <GradientStop Color="#EE000000" Offset="0"/>
                        <GradientStop Color="#AA550000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="180" Height="180" Opacity="0.6">
                <Border.Background>
                    <RadialGradientBrush Center="0%,100%" GradientOrigin="0%,100%">
                        <GradientStop Color="#EE000000" Offset="0"/>
                        <GradientStop Color="#AA550000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="180" Height="180" Opacity="0.6">
                <Border.Background>
                    <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%">
                        <GradientStop Color="#EE000000" Offset="0"/>
                        <GradientStop Color="#AA550000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <!-- Inner red glow border - proper screen border -->
            <Border Margin="0" BorderThickness="6" CornerRadius="0" Opacity="0.5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8B0000" Offset="0"/>
                        <GradientStop Color="#FFFF4500" Offset="0.5"/>
                        <GradientStop Color="#FF8B0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#FF4500" BlurRadius="30" Opacity="0.9"/>
                </Border.Effect>
            </Border>
        </Grid>
        
        <!-- Fullscreen black fader used for cross-screen transitions -->
        <Rectangle x:Name="ScreenFader"
               Fill="Black"
               Opacity="0"
               IsHitTestVisible="False" />

        <!-- Splash Screen -->
        <Grid x:Name="SplashScreen" IsVisible="True" ZIndex="1000">
            <Grid.Background>
                <ImageBrush Source="avares://MusicClicker/Gameplay Components/Resources/Assets/System Images/Splash Screen-min.jpg" Stretch="UniformToFill" />
            </Grid.Background>
        </Grid>

    </Grid>
</Window>