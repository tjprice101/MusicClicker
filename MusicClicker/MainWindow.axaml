<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MusicClicker.Views"
        x:Class="MusicClicker.MainWindow"
        Title="Magnum Opus"
        Width="1600" Height="900">

    <Window.Background>
        <ImageBrush
            Source="avares://MusicClicker/Assets/sacredtrevor_A_grand_musical_city_lights_everywhere_popular_shi_d84ff662-c87b-4630-9887-25228f42097b-min.png"
            Stretch="UniformToFill" />
    </Window.Background>

    <Grid>
        <!-- Main Screen -->
        <Grid x:Name="MainScreen">
            <!-- Top-left Save button -->
<StackPanel HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Vertical"
            Spacing="6"
            Margin="12,12,0,0"
            Panel.ZIndex="500">

    <Border CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              BlurRadius="15" 
                              Opacity="0.7"
                              OffsetX="0"
                              OffsetY="0" />
        </Border.Effect>
        <Button x:Name="TopSaveButton"
                Width="250"     
                Height="140"  
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <Image Source="avares://MusicClicker/Assets/SaveIcon.png"
                   Stretch="Uniform" IsHitTestVisible="False" />
        </Button>
    </Border>

    <TextBlock x:Name="SaveStatusText"
               Text=""
               Foreground="White"
               FontSize="14"
               HorizontalAlignment="Left" />
</StackPanel>


            <!-- Top-right Upgrades button (image) -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8" Margin="0,12,12,0" Panel.ZIndex="500">
                <Border CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" 
                                          BlurRadius="15" 
                                          Opacity="0.7"
                                          OffsetX="0"
                                          OffsetY="0" />
                    </Border.Effect>
                    <Button x:Name="TopOpenUpgradesButton" Width="250" Height="140" Background="Transparent" BorderThickness="0" Padding="0">
                        <Image Source="avares://MusicClicker/Assets/UpgradeMenu.png" Stretch="UniformToFill" Width="250" Height="140" IsHitTestVisible="False" />
                    </Button>
                </Border>
            </StackPanel>
            <!-- Center Content -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Title and Notes -->
                    <RowDefinition Height="Auto" /> <!-- Click Button with Carousel -->
                    <RowDefinition Height="Auto" /> <!-- Upgrades Button -->
                </Grid.RowDefinitions>

                <!-- Title and Notes -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,30">
                    <TextBlock Text="Magnum Opus"
                               FontSize="36"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontWeight="Bold" />
                    <TextBlock x:Name="NotesText"
                               Text="Notes: 0"
                               FontSize="28"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="NpsText"
                               Text="Notes Per Second: 0"
                               FontSize="22"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Main Click Button with Carousel Behind It -->
                <Grid Grid.Row="1"
                      Width="1400"
                      Height="1400"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,-150,0,0">

                    <!-- Carousel Canvas (Behind) -->
                    <Canvas x:Name="CarouselCanvas"
                            Width="1400"
                            Height="1400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="False"
                            Background="Transparent">

                        <!-- Button 0: Fragmentation -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="FragmentationButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/Fragmentation Button-min.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 1: Resonance -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="ResonanceButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [C690BBF]-min.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 2: Melody -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="MelodyButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [2299EA4]-min.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 3: Harmony -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="HarmonyButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/Music Game 16_9 Assets [5A28B4B]-min.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 4: Tempo Resonate -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="TempoResonateButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/TempoResonate.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 5: Eternal Modulation -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="EternalModulationButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/EternalModulation.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 6: Armory of Forte -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                                <Button x:Name="ArmoryOfForteButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/ArmoryofForte.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        <!-- Button 7: Symphonic Gallery -->
                        <Border Canvas.Left="503" Canvas.Top="100" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  BlurRadius="15" 
                                                  Opacity="0.7"
                                                  OffsetX="0"
                                                  OffsetY="0" />
                            </Border.Effect>
                            <Button x:Name="SymphonicGalleryButton"
                                    Width="374"
                                    Height="213">
                                <Image Source="avares://MusicClicker/Assets/SymphonicGallery.png"
                                       Stretch="UniformToFill" />
                            </Button>
                        </Border>

                        

                    </Canvas>

                    <!-- Main Click Button (with shadow like carousel buttons) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,180,0,0" CornerRadius="110" ZIndex="200">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" 
                                              BlurRadius="15" 
                                              Opacity="0.7"
                                              OffsetX="0"
                                              OffsetY="0" />
                        </Border.Effect>
                        <Button x:Name="ClickButton"
                                Width="220"
                                Height="220"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Image Source="avares://MusicClicker/Assets/Music Game Assets [A961E2A]-min.png"
                                   Stretch="Uniform" IsHitTestVisible="False" />
                        </Button>
                    </Border>
                </Grid>

                <!-- Upgrades Button -->
                <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,30,0,0" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" 
                                          BlurRadius="15" 
                                          Opacity="0.7"
                                          OffsetX="0"
                                          OffsetY="0" />
                    </Border.Effect>
                    <Button x:Name="OpenUpgradesButton"
                            Content="Upgrades"
                            Width="250"
                            Height="140"
                            Background="#55000000"
                            Foreground="White"
                            FontSize="20"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,0" />
                </Border>
            </Grid>
        </Grid>

        <!-- Game Screens -->
        <views:TempoResonateScreen x:Name="TempoResonateScreen" IsVisible="False" />
        <views:UpgradeScreen x:Name="UpgradeScreen" IsVisible="False" />
        <views:FragmentationScreen x:Name="FragmentationScreen" IsVisible="False" />
        <views:SaveScoresScreen x:Name="SaveScoresScreen" IsVisible="False" />
        <views:HeartOfHarmonyScreen x:Name="HeartOfHarmonyScreen" IsVisible="False" />
        <views:UniteTheSymphonyScreen x:Name="UnityTheSymphonyScreen" IsVisible="False" />
        <views:ArmoryOfForteScreen x:Name="ArmoryOfForteScreen" IsVisible="False" />
        <views:EternalModulationScreen x:Name="EternalModulationScreen" IsVisible="False" />
        
        <!-- Currently Active Events. Comment out any events that are not currently active in sets of 2. (Top = left and bottom = right) -->
        <views:DiesIraeEventScreen x:Name="DiesIraeEventScreen" IsVisible="False" />
        <views:WinterEventScreen x:Name="WinterEventScreen" IsVisible="False" />

        <views:SymphonicGalleryScreen x:Name="SymphonicGalleryScreen" IsVisible="False" />
        <views:ClickerCustomizeScreen x:Name="ClickerCustomizeScreen" IsVisible="False" />
        <views:BackgroundCustomizeScreen x:Name="BackgroundCustomizeScreen" IsVisible="False" />
        
        <!-- Fullscreen black fader used for cross-screen transitions -->
        <Rectangle x:Name="ScreenFader"
               Fill="Black"
               Opacity="0"
               IsHitTestVisible="False" />

    </Grid>
</Window>